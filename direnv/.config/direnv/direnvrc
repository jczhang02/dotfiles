# shellcheck shell=bash
# vim: ft=bash

layout_mamba() {
    if [[ $# -ne 1 ]]; then
        log_error "usage: layout mamba <environment>"
        return 1
    fi

    export MAMBA_ROOT_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/mamba"

    local activation
    activation="$(command mamba shell activate --shell bash "$1")" || return
    eval "$activation"
}
