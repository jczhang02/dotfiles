[user]
	name = JC Zhang
    email = jczhang@live.it
    signingkey = 1F863CBFD6EDCA6B
[commit]
    gpgsign = true
    template = ~/.config/git/git-commit-template.txt
[gpg]
    program = /usr/bin/gpg
[alias]
    logs = log --show-signature

[core]
    pager = bat
    editor = nvim

[interactive]
    diffFilter = delta 
[add.interactive]
    useBuiltin = false # required for git 2.37.0

[delta]
    navigate = true    # use n and N to move between diff sections
    light = true       # fixed for the Catppuccin Latte terminal palette

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[init]
    defaultBranch = main
    # templatedir = ~/.config/git/git_template/template

[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[includeIf "gitdir:/home/jc/dev/GingiCasc/**"]
	path = /home/jc/.gitconfig-gingicasc-lynn
