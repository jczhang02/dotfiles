[user]
	name = JC Zhang
    email = jczhang@live.it
    signingkey = 1F863CBFD6EDCA6B
[commit]
    gpgsign = true
    template = ~/.config/git/git-commit-template.txt
[gpg]
    program = /usr/bin/gpg
[alias]
    logs = log --show-signature
    rs = !hunk show

[core]
    pager = bat
    editor = nvim

[pager]
    # hunk drops commit headers, so only diff uses it; show/log stay on bat.
    diff = hunk pager

[interactive]
    diffFilter = delta --color-only

[delta]
    light = true       # fixed for the Catppuccin Latte terminal palette

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[init]
    defaultBranch = main
    # templatedir = ~/.config/git/git_template/template

[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[includeIf "gitdir:~/dev/GingiCasc/**"]
	path = ~/.gitconfig-gingicasc-lynn
