#!/bin/sh
# Run delta with the Catppuccin feature that matches the GNOME color scheme,
# as Ghostty does (theme = light:catppuccin-latte,dark:catppuccin-mocha).
case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
*dark*) features=mocha ;;
*) features=latte ;;
esac
exec delta --features "$features" "$@"
