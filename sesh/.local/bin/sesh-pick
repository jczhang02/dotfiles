#!/usr/bin/env bash
# sesh-pick — shared fzf picker for sesh (zsh startup + tmux `prefix s` popup).
#
#   sesh-pick           pick, then `sesh connect` (tmux popup)
#   sesh-pick --print   pick, print the target; caller connects (zsh startup)
#
# Internal, used by fzf bindings:
#   sesh-pick --list MODE     MODE: all | tmux | config | zoxide | find | current
#   sesh-pick --kill NAME     kill NAME only if it is a live tmux session
#                             other than the one we are attached to
#
# Rows are "target<TAB>display"; fzf shows only the display column.
# Enter on a query with no match: an existing directory becomes a session at
# that path; anything else becomes a new tmux session in $HOME.

set -uo pipefail

self=${BASH_SOURCE[0]}
export _ZO_EXCLUDE_DIRS=${_ZO_EXCLUDE_DIRS:-$HOME/Documents/sync/**}

# Render sesh JSON entries as aligned rows: icon, name, path, window meta.
# `all` also drops zoxide entries whose path a session or config already covers.
format() {
    # stdout is a pipe here, so ask the tty; fzf exports FZF_COLUMNS on reload.
    local width=${FZF_COLUMNS:-}
    [[ -n $width ]] || width=$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2)
    width=${width:-100}
    jq -r --arg home "$HOME" --argjson width "$width" --argjson dedupe "${1:-false}" '
        def tilde: if startswith($home) then "~" + .[($home | length):] else . end;
        def spaces($n): [range(0; $n)] | map(" ") | join("");
        def fit($n): if length > $n then .[0:$n - 1] + "…" else . + spaces($n - length) end;
        def lfit($n): if length > $n then "…" + .[length - $n + 1:] else . + spaces($n - length) end;
        def dim: "\u001b[2m" + . + "\u001b[0m";

        ($width - 6) as $inner
        | 24 as $nw | 5 as $mw
        | ([$inner - $nw - $mw - 6, 12] | max) as $pw
        | (if $dedupe then
               reduce .[] as $e ({seen: {}, out: []};
                   ($e.Path | rtrimstr("/")) as $k
                   | if $e.Src == "zoxide" and .seen[$k] then .
                     else .seen[$k] = true | .out += [$e] end)
               | .out
           else . end)
        | .[]
        | ((if .Src == "tmux" then "\u001b[34m"
           elif .Src == "config" then "\u001b[35m"
           else "\u001b[36m" end) + "\u001b[0m") as $icon
        | (if .Src == "zoxide" or .Src == "find" then .Path | rtrimstr("/") | split("/") | last
           else .Name end) as $label
        | (if .Src == "tmux" then
               "\(.Windows)w" + (if .Attached > 0 then " ●" else "  " end)
           else "" end) as $meta
        | [.Name,
           "\($icon) \($label | fit($nw))  \(.Path | rtrimstr("/") | tilde | lfit($pw) | dim)  \($meta | dim)"]
        | join("\t")'
}

list() {
    case $1 in
        all) sesh list -d -t -c -z -j | format true ;;
        tmux) sesh list -t -j | format ;;
        config) sesh list -c -j | format ;;
        zoxide) sesh list -z -j | format ;;
        find)
            command -v fd >/dev/null || return 0
            fd -H -d 2 -t d -E .git . "$HOME/dev" |
                jq -R --arg home "$HOME" '
                    rtrimstr("/") as $p
                    | {Src: "find", Path: $p, Name: ("~" + $p[($home | length):])}' |
                jq -s . | format
            ;;
        current)
            case ${FZF_LIST_LABEL:-} in
                ' tmux ') list tmux ;;
                ' config ') list config ;;
                ' zoxide ') list zoxide ;;
                ' ~/dev ') list find ;;
                *) list all ;;
            esac
            ;;
    esac
}

kill_session() {
    local name=$1
    tmux has-session -t "=$name" 2>/dev/null || return 0
    if [[ -n ${TMUX:-} && $name == "$(tmux display-message -p '#S')" ]]; then
        return 0
    fi
    tmux kill-session -t "=$name"
}

# Turn an unmatched query into something `sesh connect` accepts.
new_target() {
    local query=$1 name
    if [[ -d ${query/#\~/$HOME} ]]; then
        printf '%s\n' "$query"
        return
    fi
    name=${query//[.:]/_} # tmux forbids . and : in session names
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$HOME"
    printf '%s\n' "$name"
}

# change-list-label + reload for a mode switch key.
mode_bind() {
    printf '%s:change-list-label( %s )+reload(%s --list %s)+first' "$1" "$2" "$self" "$3"
}

pick() {
    local mode=$1 entries esc_hint query selection main_pos
    entries=$(list all)

    # shellcheck disable=SC2054 # commas belong to fzf options
    local -a opts=(
        --ansi --delimiter='\t' --with-nth=2 --tiebreak=begin,index --sync
        --layout=reverse --style=full:rounded --no-scrollbar
        --highlight-line --gutter=' ' --pointer='▌'
        --prompt='❯ ' --ghost='session, project or path' --info=inline-right
        --input-label=' sesh ' --list-label=' all ' --list-label-pos=-3:bottom
        --footer-border=none
        --print-query
        --preview='sesh preview {1}'
        --preview-window='hidden,right,55%,<100(hidden,down,45%)'
        --bind='tab:down,btab:up'
        --bind='ctrl-/:toggle-preview'
        --bind='enter:accept-or-print-query'
        --bind="$(mode_bind ctrl-a all all)"
        --bind="$(mode_bind ctrl-t tmux tmux)"
        --bind="$(mode_bind ctrl-g config config)"
        --bind="$(mode_bind ctrl-x zoxide zoxide)"
        --bind="ctrl-d:execute-silent($self --kill {1})+reload($self --list current)"
    )
    local keys='^a all  ^t tmux  ^g config  ^x zoxide'
    if command -v fd >/dev/null; then
        # shellcheck disable=SC2088 # "~/dev" is a list label, not a path
        opts+=(--bind="$(mode_bind ctrl-f "~/dev" find)")
        keys+='  ^f ~/dev'
    fi
    # Quiet chrome when the Catppuccin Latte palette is active.
    if [[ -n ${FZF_DEFAULT_OPTS:-} ]]; then
        opts+=(--color='border:#bcc0cc,label:#8839ef,footer:#8c8fa1,ghost:#9ca0b0')
    fi

    if [[ $mode == print ]]; then
        esc_hint='esc shell'
        opts+=(--height=80%)
        # Start on `main` so a plain Enter lands in the everyday session.
        main_pos=$(cut -f1 <<<"$entries" | awk '$0 == "main" { print NR; exit }')
        [[ -n $main_pos ]] && opts+=(--bind="start:pos($main_pos)")
    else
        esc_hint='esc close'
    fi
    opts+=(--footer="$keys
^d kill  ^/ preview  ⏎ new if no match  $esc_hint")

    local out
    out=$(fzf "${opts[@]}" <<<"$entries") || return 1
    { IFS= read -r query; IFS= read -r selection; } <<<"$out"

    if [[ -n $selection ]]; then
        printf '%s\n' "${selection%%$'\t'*}"
    elif [[ -n $query ]]; then
        new_target "$query"
    else
        return 1
    fi
}

case ${1:-} in
    --list) list "${2:-all}" ;;
    --kill) kill_session "${2:?}" ;;
    --print) pick print ;;
    '')
        target=$(pick connect) || exit 0
        exec sesh connect "$target"
        ;;
    *)
        echo "usage: sesh-pick [--print]" >&2
        exit 2
        ;;
esac
