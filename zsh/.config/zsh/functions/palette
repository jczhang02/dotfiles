# DESC: Print the 256-color palette; pass -b or a numeric background.

local -a colors
local bold='' background='%K{000}' argument color

for argument in "$@"; do
    [[ $argument == -b ]] && bold='%B'
    [[ $argument == <-> ]] && background="%K{$argument}"
done

for color in {000..255}; do
    colors+=("$bold$background%F{$color}$color%f%k${(L)bold}")
done

print -cP -- $colors
