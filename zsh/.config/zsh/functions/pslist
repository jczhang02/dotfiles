# DESC: List autoloadable Zsh functions and their embedded descriptions.

local function_dir=${1:-$XDG_CONFIG_HOME/zsh/functions}
[[ -d $function_dir ]] || return 1

local file description
for file in "$function_dir"/*(.N); do
    [[ ${file:t} == *.* ]] && continue
    description=$(command grep -m 1 '^# DESC: ' -- "$file" 2>/dev/null)
    description=${description#\# DESC: }
    printf '%-32s %s\n' "${file:t}" "$description"
done
