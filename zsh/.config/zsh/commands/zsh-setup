#!/usr/bin/env bash

set -euo pipefail

readonly zi_repository=https://github.com/z-shell/zi.git
readonly zi_commit=431fd9ce9e6e1acb155b6da265b10307936eacd7
readonly config_home=${XDG_CONFIG_HOME:-$HOME/.config}
readonly zdotdir=${ZDOTDIR:-$config_home/zsh}
readonly zi_bin=$zdotdir/zi/bin

for command_name in git zsh; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'zsh-setup: required command is missing: %s\n' "$command_name" >&2
        exit 127
    fi
done

if [[ ! -t 0 || ! -t 1 ]]; then
    printf '%s\n' 'zsh-setup: run this command from an interactive terminal.' >&2
    exit 2
fi

if [[ ! -d $zi_bin/.git ]]; then
    mkdir -p -- "$zi_bin"
    git -C "$zi_bin" init
    git -C "$zi_bin" remote add origin "$zi_repository"
fi

git -C "$zi_bin" fetch --depth=1 origin "$zi_commit"
git -C "$zi_bin" checkout --detach "$zi_commit"

printf '%s\n' 'Installing missing Zsh plugins explicitly...'
rm -f -- "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompdump" \
    "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompdump.zwc"
ZSH_PLUGIN_INSTALL=1 ZSH_NO_SESSIONIZER=1 zsh -ic 'exit'

printf '%s\n' 'Validating the installed plugins in offline startup mode...'
ZSH_PLUGIN_INSTALL=0 ZSH_NO_SESSIONIZER=1 zsh -ic '(( ZSH_PLUGINS_READY ))'
printf '%s\n' 'Zsh plugin setup complete.'
