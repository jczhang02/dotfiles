#autoload

# Completion helpers for Gentoo package atoms, sets and USE flags.
#
# Usage: _gentoo_packages [compadd options] KIND
#   installed          installed package names and category/package
#   installed_versions installed category/package-version
#   installed_sets     sets recorded in the world_sets file
#   available          package names and category/package from all repos
#   available_versions category/package-version from all repos
#   available_pkgnames_only
#                      package names from all repos
#   available_sets     every set Portage knows (@world, @system, user sets, ...)
#   binary             category/package of binary packages in PKGDIR
#   category           categories from all repos
#   useflag            global, local and USE_EXPAND flags from all repos
#   active_useflag     flags enabled in the current configuration
#
# Slow lookups (USE flag descriptions, the active USE set) are memoized for the
# shell session and recomputed when their source files change.

_gentoo_pkg_vdb=${EPREFIX}/var/db/pkg

# Strip the version (and revision) from a PF such as font-adobe-100dpi-1.0.4-r1.
# Only the last "-<digit>..." component is the version, so use the shortest match.
_gentoo_packages_pn() {
  REPLY=${1%-[0-9]*}
}

# Categories: profiles/categories is authoritative (it includes "virtual",
# which a *-* glob misses).
_gentoo_packages_categories() {
  local repo
  reply=()
  for repo in $(_gentoo_repos); do
    [[ -r $repo/profiles/categories ]] && reply+=(${(f)"$(<$repo/profiles/categories)"})
  done
  reply=(${(u)reply})
}

_gentoo_packages_update_category() {
  local -a reply
  _gentoo_packages_categories
  _wanted categories expl 'category' compadd "$@" -a reply
}

# Complete CATEGORY/NAME in two steps: first the category with a "/" suffix,
# then the names found under that category in the given directories.
# $1: tag  $2: description  $3: array of base directories  $4: glob for names
# $5: "pn" to strip versions from the names (for the installed package db)
_gentoo_packages_cat_pkg() {
  local tag=$1 descr=$2 dirs_var=$3 glob=$4 strip=$5
  shift 5
  local -a cats names

  if compset -P '*/'; then
    local cat=${IPREFIX%/}
    cat=${cat##*[=<>~]}
    names=(${^${(P)dirs_var}}/$cat/${~glob})
    names=(${names:t})
    [[ $strip == pn ]] && names=(${names%-[0-9]*})
    names=(${(u)names})
    _wanted $tag expl "$descr" compadd "$@" -a names
  else
    cats=(${^${(P)dirs_var}}/*-*(N/:t) ${^${(P)dirs_var}}/virtual(N/:t))
    cats=(${(u)cats})
    _wanted categories expl 'category' compadd "$@" -S / -q -a cats
  fi
}

_gentoo_packages_update_installed() {
  local -a pfs pns atoms vdb=($_gentoo_pkg_vdb)
  local pf REPLY

  pfs=($_gentoo_pkg_vdb/*-*/*(N/))
  for pf in ${pfs:t}; do _gentoo_packages_pn $pf; pns+=($REPLY); done
  _wanted packages expl 'installed package' compadd "$@" -a pns

  _gentoo_packages_cat_pkg installed-packages 'installed category/package' vdb '*(N/)' pn "$@"
}

_gentoo_packages_update_installed_versions() {
  local -a pfs vdb=($_gentoo_pkg_vdb)

  if [[ $PREFIX != */* ]]; then
    pfs=($_gentoo_pkg_vdb/*-*/*(N/:t))
    _wanted packages expl 'installed package version' compadd "$@" -a pfs
  fi
  _gentoo_packages_cat_pkg installed-versions 'installed category/package-version' vdb '*(N/)' "" "$@"
}

_gentoo_packages_update_installed_sets() {
  local -a sets
  [[ -r ${EPREFIX}/var/lib/portage/world_sets ]] &&
    sets=(${(f)"$(<${EPREFIX}/var/lib/portage/world_sets)"})
  (( $#sets )) && _wanted installed-sets expl 'installed set' compadd "$@" -a sets
}

_gentoo_packages_update_available_pkgnames_only() {
  local -a repos names
  repos=($(_gentoo_repos))
  names=(${^repos}/*-*/*(N/:t) ${^repos}/virtual/*(N/:t))
  _wanted packages expl 'package' compadd "$@" -a names
}

_gentoo_packages_update_available() {
  local -a repos
  repos=($(_gentoo_repos))

  [[ $PREFIX != */* ]] && _gentoo_packages_update_available_pkgnames_only "$@"
  _gentoo_packages_cat_pkg available-packages 'category/package' repos '*(N/)' "" "$@"
}

# category/package-version from ebuild file names. After "cat/" the names are
# offered only for packages whose name starts with what was typed.
_gentoo_packages_update_available_versions() {
  local -a repos ebuilds
  repos=($(_gentoo_repos))

  if compset -P '*/'; then
    local cat=${IPREFIX%/} pn=${${PREFIX%%-[0-9]*}%-}
    cat=${cat##*[=<>~]}
    ebuilds=(${^repos}/$cat/${pn}*/*.ebuild(N:t:r))
    _wanted available-versions expl 'package version' compadd "$@" -a ebuilds
  else
    if [[ -n $PREFIX ]]; then
      ebuilds=(${^repos}/*-*/${${PREFIX%%-[0-9]*}%-}*/*.ebuild(N:t:r))
      _wanted available-versions expl 'package version' compadd "$@" -a ebuilds
    fi
    local -a reply
    _gentoo_packages_categories
    _wanted categories expl 'category' compadd "$@" -S / -q -a reply
  fi
}

# Set names, as `emerge --list-sets` reports them: sections of every sets.conf
# (except multiset sections, which expand to the files of a directory) plus the
# files in those directories.
_gentoo_packages_update_available_sets() {
  local -a conf_files set_dirs sets repos
  local file line section repo

  repos=($(_gentoo_repos))
  conf_files=(
    ${EPREFIX}/usr/share/portage/config/sets/*.conf(N.)
    ${EPREFIX}/etc/portage/sets.conf(N.)
    ${EPREFIX}/etc/portage/sets.conf/*.conf(N.)
    ${^repos}/sets.conf(N.)
    ${^repos}/sets.conf/*.conf(N.)
  )
  set_dirs=(${EPREFIX}/etc/portage/sets(N/) ${^repos}/sets(N/))

  for file in $conf_files; do
    section=
    while IFS= read -r line; do
      if [[ $line == '['*']'* ]]; then
        [[ -n $section ]] && sets+=($section)
        section=${${line#\[}%%\]*}
      elif [[ $line == [[:space:]]#multiset[[:space:]]#=[[:space:]]#(true|yes|1)* ]]; then
        section=
      fi
    done < $file
    [[ -n $section ]] && sets+=($section)
  done
  sets+=(${^set_dirs}/*(N.:t))
  sets=(${(u)sets})

  (( $#sets )) && _wanted available-sets expl 'set' compadd "$@" -P @ -a sets
}

# Binary packages in PKGDIR. The Packages index is world-readable even when the
# category directories are not, so prefer it; otherwise list the directory
# (flat cat/pkg-ver.tbz2 or binpkg-multi-instance cat/pkg/pkg-ver-N.gpkg.tar).
_gentoo_packages_update_binary() {
  local PKGDIR pkgdir
  pkgdir=$(source ${EPREFIX}/etc/portage/make.conf 2>/dev/null; print -r -- $PKGDIR)
  [[ -d $pkgdir ]] || pkgdir=${EPREFIX}/var/cache/binpkgs

  local -a atoms entries
  local entry REPLY
  if [[ -r $pkgdir/Packages ]]; then
    for entry in ${${(M)${(f)"$(<$pkgdir/Packages)"}:#CPV: *}#CPV: }; do
      _gentoo_packages_pn $entry
      atoms+=($REPLY)
    done
  else
    for entry in $pkgdir/*-*/*(N); do
      if [[ -d $entry ]]; then
        atoms+=(${entry:h:t}/${entry:t})
      else
        _gentoo_packages_pn ${${entry:t}%%.(tbz2|xpak|gpkg.tar)}
        atoms+=(${entry:h:t}/$REPLY)
      fi
    done
  fi
  atoms=(${(u)atoms})
  _wanted binary-packages expl 'binary package' _multi_parts "$@" / atoms
}

# USE flag names with descriptions. Global flags come from use.desc, local ones
# from use.local.desc (one entry per flag, the first description wins) and
# USE_EXPAND values from profiles/desc/*.desc (flag = <file name>_<value>).
typeset -gA _gentoo_useflag_cache

_gentoo_packages_update_useflag() {
  local -a repos descs
  local repo stamp f line flag
  repos=($(_gentoo_repos))

  zmodload -F zsh/stat b:zstat 2>/dev/null
  local -a mtimes
  descs=(${^repos}/profiles/use.desc(N) ${^repos}/profiles/use.local.desc(N) ${^repos}/profiles/desc/*.desc(N))
  zstat -A mtimes +mtime -- $descs 2>/dev/null
  stamp="${(j: :)repos}|${(j: :)mtimes}"

  if [[ ${_gentoo_useflag_cache[stamp]} != $stamp ]]; then
    local -A global local expand
    for repo in $repos; do
      if [[ -r $repo/profiles/use.desc ]]; then
        for line in ${(f)"$(<$repo/profiles/use.desc)"}; do
          [[ $line == [[:alnum:]]*' - '* ]] || continue
          flag=${line%% - *}
          (( $+global[$flag] )) || global[$flag]=${line#* - }
        done
      fi
      if [[ -r $repo/profiles/use.local.desc ]]; then
        for line in ${(f)"$(<$repo/profiles/use.local.desc)"}; do
          [[ $line == [[:alnum:]]*:*' - '* ]] || continue
          flag=${${line%% - *}#*:}
          (( $+global[$flag] || $+local[$flag] )) || local[$flag]="${line#* - } (${line%%:*})"
        done
      fi
      for f in $repo/profiles/desc/*.desc(N); do
        for line in ${(f)"$(<$f)"}; do
          [[ $line == [[:alnum:]]*' - '* ]] || continue
          flag=${f:t:r}_${line%% - *}
          (( $+expand[$flag] )) || expand[$flag]=${line#* - }
        done
      done
    done
    _gentoo_useflag_cache=(
      stamp $stamp
      global "${(pj:\0:)${(@kv)global}}"
      local "${(pj:\0:)${(@kv)local}}"
      expand "${(pj:\0:)${(@kv)expand}}"
    )
  fi

  local kind descr ret=1
  local -A table
  local -a flags disp
  for kind descr in global 'global USE flag' local 'local USE flag' expand 'USE_EXPAND flag'; do
    table=("${(@ps:\0:)_gentoo_useflag_cache[$kind]}")
    flags=(${(ko)table})
    disp=()
    for flag in $flags; do disp+=("$flag -- ${table[$flag]}"); done
    _wanted $kind-useflags expl $descr compadd "$@" -l -d disp -a flags && ret=0
  done
  return ret
}

# Flags enabled in the current configuration (profile + make.conf + env),
# without USE_EXPAND and arch flags, which are rarely toggled by hand.
typeset -gA _gentoo_active_use_cache

_gentoo_packages_update_active_useflag() {
  local stamp profile
  profile=$(readlink -f ${EPREFIX}/etc/portage/make.profile 2>/dev/null)
  zmodload -F zsh/stat b:zstat 2>/dev/null
  local -a mtimes
  zstat -A mtimes +mtime -- ${EPREFIX}/etc/portage/make.conf(N) ${EPREFIX}/etc/portage/make.conf/*(N) 2>/dev/null
  stamp="$profile|${(j: :)mtimes}|$USE"

  if [[ ${_gentoo_active_use_cache[stamp]} != $stamp ]]; then
    local out
    out=$(_call_program active-useflags portageq envvar USE USE_EXPAND USE_EXPAND_HIDDEN ARCH 2>/dev/null)
    local -a lines=("${(@f)out}")
    local -a use=(${=lines[1]}) expand=(${(L)=lines[2]} ${(L)=lines[3]})
    local arch=${lines[4]}
    local prefix
    use=(${use:#$arch})
    for prefix in $expand; do use=(${use:#${prefix}_*}); done
    _gentoo_active_use_cache=(stamp $stamp flags "${(j: :)${(o)use}}")
  fi

  local -a flags=(${=_gentoo_active_use_cache[flags]})
  _wanted active-useflags expl 'enabled USE flag' compadd "$@" -a flags
}

_gentoo_packages() {
  local kind=$argv[-1] expl
  argv[-1]=()
  case $kind in
    installed|installed_versions|installed_sets|available|available_versions|\
    available_sets|available_pkgnames_only|binary|category|useflag|active_useflag)
      _gentoo_packages_update_$kind "$@"
      ;;
    *)
      _message "unknown package kind: $kind"
      return 1
      ;;
  esac
}

_gentoo_packages "$@"

