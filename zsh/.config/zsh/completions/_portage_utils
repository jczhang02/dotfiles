# Completion for app-portage/portage-utils.
#
# The option list of every applet is read from its own --help output, so it
# always matches the installed version; each --help runs in a few ms and is
# memoized for the session. Only what the values mean is described here.

typeset -gA _portage_utils_help

# Value of an option that takes <arg>, by applet (or "*") and long option.
typeset -gA _portage_utils_values=(
  '*:--format'       'format string:'
  '*:--root'         'root directory:_files -/'
  'qcheck:--skip'    'regular expression:'
  'qfile:--exclude'  'package:_gentoo_packages installed'
  'qgrep:--skip'     'regular expression:'
  'qgrep:--before'   'lines:'
  'qgrep:--after'    'lines:'
  'qkeyword:--matchpkg'   'package name:_gentoo_packages available_pkgnames_only'
  'qkeyword:--matchcat'   'category:_gentoo_packages category'
  'qkeyword:--matchmaint' 'maintainer email:'
  'qlop:--date'      'date:'
  'qlop:--logfile'   'emerge log:_files'
  'qlop:--atoms'     'file with atoms:_files'
  'qmanifest:--signas' 'GPG key:_portage_utils_gpg_keys'
  'qpkg:--pkgdir'    'package directory:_files -/'
  'qsearch:--desc'   'regular expression:'
  'qsize:--ignore'   'regular expression:'
  'qtbz2:--dir'      'directory:_files -/'
  'qtegrity:--add'   'file:_files'
  'quse:--package'   'package or category:_gentoo_packages available'
  'qxpak:--dir'      'directory:_files -/'
)

# Positional argument specs, by applet (several are separated by newlines).
typeset -gA _portage_utils_args=(
  qatom     '*:atom:'
  qcheck    '*:installed package:_gentoo_packages installed'
  qdepends  '*:package:_gentoo_packages installed'
  qfile     '*:file:_files'
  qgrep     $'1:expression:\n*:package:_gentoo_packages available'
  qkeyword  '*:arch:_portage_utils_arches'
  qlist     '*:installed package:_gentoo_packages installed'
  qlop      '*:package:_gentoo_packages installed'
  qmanifest '*:directory or repository:_portage_utils_manifest_targets'
  qmerge    '*:binary package:_gentoo_packages binary'
  qpkg      '*:installed package:_gentoo_packages installed'
  qsearch   '*:regular expression:'
  qsize     '*:installed package:_gentoo_packages installed'
  qtbz2     '*:binary package file:_files -g "*.(tbz2|xpak|gpkg.tar)(-.)"'
  qtegrity  '*:file:_files'
  quse      '*:USE flag:_gentoo_packages useflag'
  qwhich    '*:package:_gentoo_packages available'
  qxpak     '*:xpak archive or file:_files'
)

_portage_utils_arches() {
  local -a arches=($(_gentoo_arches))
  _wanted arches expl 'arch' compadd "$@" -a arches
}

# Secret keys usable for signing (_gpg would re-run the current command).
_portage_utils_gpg_keys() {
  local -a keys fields
  local line
  for line in ${(f)"$(_call_program gpg-keys gpg --list-secret-keys --with-colons 2>/dev/null)"}; do
    fields=("${(@s.:.)line}")
    case $fields[1] in
      sec) keys+=($fields[5]) ;;
      uid) [[ -n $keys[-1] && $keys[-1] != *:* ]] && keys[-1]+=":${fields[10]//:/\\:}" ;;
    esac
  done
  _describe -t keys 'secret key' keys
}

_portage_utils_manifest_targets() {
  local -a repos=($(_gentoo_repos_conf -l))
  _alternative \
    "repositories:repository:compadd -a repos" \
    'directories:directory:_files -/'
}

# Turn "  -F, --format <arg> * Print ..." lines into _arguments specs.
_portage_utils_specs() {
  local applet=$1 line short long arg desc value excl rep
  local -a specs

  if (( ! $+_portage_utils_help[$applet] )); then
    _portage_utils_help[$applet]=$(_call_program help $applet --help 2>/dev/null)
  fi

  for line in ${(f)_portage_utils_help[$applet]}; do
    [[ $line =~ '^ +(-([[:alnum:]]), +)?(--[[:alnum:]-]+)( <arg>)? +\* (.*)$' ]] || continue
    short=$match[2] long=$match[3] arg=$match[4]
    desc=${${${match[5]//\\/\\\\}//\[/\\[}//\]/\\]}
    value=
    if [[ -n $arg ]]; then
      value=${_portage_utils_values[$applet:$long]:-${_portage_utils_values[*:$long]:-value:}}
      value=":$value"
    fi
    # -v, -q and -S may be given more than once.
    [[ $short == [vqS] ]] && rep='*' || rep=
    if [[ -n $short ]]; then
      excl="($rep-$short $long)"
      [[ -n $rep ]] && excl=
      if [[ -n $arg ]]; then
        specs+=("${excl}${rep}-${short}+[$desc]$value" "${excl}${rep}${long}=[$desc]$value")
      else
        specs+=("${excl}${rep}-${short}[$desc]" "${excl}${rep}${long}[$desc]")
      fi
    elif [[ -n $arg ]]; then
      specs+=("${long}=[$desc]$value")
    else
      specs+=("${long}[$desc]")
    fi
  done
  reply=($specs)
}

_portage_utils_applet() {
  local applet=$1
  local -a reply args
  _portage_utils_specs $applet
  args=(${(f)_portage_utils_args[$applet]})
  _arguments -s -S : $reply $args
}

_portage_utils_q() {
  if (( CURRENT == 2 )) && [[ $PREFIX != -* ]]; then
    local -a applets
    local line
    for line in ${(f)"$(_call_program applets q --help 2>/dev/null)"}; do
      [[ $line =~ '^ *(q[a-z]+) .*: (.*)$' ]] && applets+=("$match[1]:$match[2]")
    done
    _describe -t applets 'applet' applets
  elif (( CURRENT > 2 )) && [[ $words[2] == q[a-z]## ]]; then
    shift words
    (( CURRENT-- ))
    _portage_utils_applet $words[1]
  else
    _portage_utils_applet q
  fi
}

case $service in
  q) _portage_utils_q ;;
  *) _portage_utils_applet $service ;;
esac

