#autoload

# Usage:
#   _gentoo_repos    -> locations of all repos, main repo first
#   _gentoo_repos -m -> location of the main repo
#   _gentoo_repos -o -> locations of the non-main repos

_gentoo_repos() {
  emulate -L zsh

  if [[ -e ${EPREFIX}/usr/share/portage/config/repos.conf || -e ${EPREFIX}/etc/portage/repos.conf ]]; then
    case $1 in
      -m|-o) _gentoo_repos_conf $1 ;;
      *)     _gentoo_repos_conf -L ;;
    esac
    return
  fi

  # Pre-repos.conf configuration (PORTDIR / PORTDIR_OVERLAY in make.conf).
  local PORTDIR PORTDIR_OVERLAY
  source ${EPREFIX}/usr/share/portage/config/make.globals 2>/dev/null
  source ${EPREFIX}/etc/portage/make.conf 2>/dev/null
  case $1 in
    -m) print -r -- $PORTDIR ;;
    -o) print -r -- ${=PORTDIR_OVERLAY} ;;
    *)  print -r -- $PORTDIR ${=PORTDIR_OVERLAY} ;;
  esac
}

_gentoo_repos "$@"

