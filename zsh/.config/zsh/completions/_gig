(( $+functions[_gig_commands] )) ||
_gig_commands() {
    local commands; commands=(
'draft:Pre-order drafts\: notes in a hidden directory' \
'new:Register an order and scaffold its project directory' \
'ls:List orders with their next action' \
'show:Everything about one order' \
'start:queued -> in_progress (or delivered -> in_progress for a revision)' \
'change:Record a requirement change' \
'price:Set the price with a reason' \
'note:Append a timestamped note' \
'paid:delivered -> paid; starts the warranty period' \
'scorecard:Record the per-order scorecard' \
'archive:Move the project to the archive root (dry run without --yes)' \
'cancel:queued | in_progress -> cancelled' \
'cd:Print the order'\''s directory' \
'delete:Delete an order row (files untouched)' \
'package:Client packages\: build, check, upload, sent, ls' \
'artifact:Single files shared outside a package' \
'migrate:Convert a v1 database into the v2 database' \
'doctor:Consistency checks' \
'config:Read or change config.toml' \
'backup:Copy the database into the backups directory' \
'completion:Print a shell completion script' \
'version:Print the version' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'gig commands' commands "$@"
}
(( $+functions[_gig__subcmd__archive_commands] )) ||
_gig__subcmd__archive_commands() {
    local commands; commands=()
    _describe -t commands 'gig archive commands' commands "$@"
}
