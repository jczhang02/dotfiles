  _arguments -s \
    {'(--debug)-d','(-d)--debug'}'[Enable shell debugging]' \
    {'(--help)-h','(-h)--help'}'[Show help message and exit]' \
    {'(--preen)-p','(-p)--preen'}'[Auto-merge trivial changes only and exit]' \
