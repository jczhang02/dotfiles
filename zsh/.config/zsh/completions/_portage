    'master_repos:Print the master repos of a repo'
    'match:Print all installed versions matching an atom'
    'metadata:Print metadata values of a package'
    'owners:Print the packages that own the given files'
    'pkgdir:Print the PKGDIR path'
    'portdir:Print the PORTDIR path'
    'portdir_overlay:Print the PORTDIR_OVERLAY path'
    'pquery:Query packages with pquery-like options'
    'repos_config:Print the repos.conf configuration'
    'vdb_path:Print the installed package database path'
  )
  local -a repos=($(_gentoo_repos_conf -l))
  local root=':root:_files -/'

  if (( CURRENT == 2 )); then
    _describe -t commands 'portageq command' commands
    return
  fi

  case $words[2] in
    (best_version|contents|has_version|match|mass_best_version)
      _arguments ": :" "$root" '*:installed package:_gentoo_packages installed' ;;
    (best_visible|expand_virtual|mass_best_visible)
      _arguments ": :" "$root" '*:package:_gentoo_packages available' ;;
    (metadata)
      _arguments ": :" "$root" ':package type:(ebuild binary installed)' \
        ':package:_gentoo_packages available_versions' '*:metadata key:' ;;
    (available_eclasses|get_repo_path|master_repos|master_repositories)
      _arguments ": :" "$root" "*:repository:($repos)" ;;
    (eclass_path|license_path)
      _arguments ": :" "$root" ":repository:($repos)" '*:name:' ;;
    (owners|is_protected)
      _arguments ": :" "$root" '*:file:_files' ;;
    (all_best_visible|filter_protected|get_repos|list_preserved_libs|repos_config|repositories_configuration)
      _arguments ": :" "$root" ;;
    (envvar)
      _arguments ": :" '*:variable:(USE ARCH CHOST CFLAGS CXXFLAGS LDFLAGS MAKEOPTS FEATURES ACCEPT_KEYWORDS ACCEPT_LICENSE PORTDIR PKGDIR DISTDIR PORTAGE_TMPDIR EMERGE_DEFAULT_OPTS USE_EXPAND CONFIG_PROTECT)' ;;
    (*)
      _message 'no more arguments' ;;
  esac
}

zparseopts -D -E -A Args -- -emerge
if (( ${+Args[--emerge]} )); then
  _emerge "$@" && return 0
fi

case "$service" in
  emerge)
    _emerge "$@" && return 0
    ;;
  ebuild)
    _ebuild "$@" && return 0
    ;;
  quickpkg)
    _quickpkg "$@" && return 0
    ;;
  emaint)
    _emaint "$@" && return 0
    ;;
  env-update)
    _env-update "$@" && return 0
    ;;
  etc-update)
    _etc-update "$@" && return 0
    ;;
  portageq)
    _portageq "$@" && return 0
    ;;
esac

