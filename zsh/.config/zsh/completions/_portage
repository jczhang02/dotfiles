_emaint () {
  local -a repos=($(_gentoo_repos_conf -l))
  local -a commands=(
    'all:Perform all supported commands'
    'binhost:Scan and generate metadata indexes for binary packages'
    'cleanconfmem:Check and clean the config tracker list for uninstalled packages'
    'cleanresume:Discard emerge --resume merge lists'
    'logs:Check and clean old logs in the PORTAGE_LOGDIR'
    'merges:Scan for failed merges and fix them'
    'movebin:Perform package move updates for binary packages'
    'moveinst:Perform package move updates for installed and binary packages'
    'revisions:Purge repo_revisions history'
    'sync:Check repos.conf settings and sync repositories'
    'vdb:Manage the VDB consolidated metadata file'
    'world:Check and fix problems in the world file'
  )

  _arguments -s -S \
    '(- :)'{-h,--help}'[Show help message and exit]' \
    '(- :)--version[Show version and exit]' \
    '(-c --check -f --fix)'{-c,--check}'[Check for problems]' \
    '(-c --check -f --fix)'{-f,--fix}'[Attempt to fix problems]' \
    '(-C --clean)'{-C,--clean}'[Clean out old logs (logs only)]' \
    '(-t --time)'{-t,--time}'[Delete logs older than NUM days (logs only)]:days:' \
    '(-p --pretend)'{-p,--pretend}'[Output logs that would be deleted (logs only)]' \
    '(-P --purge)'{-P,--purge}'[Remove the list of previously failed merges (merges only)]' \
    '(-y --yes)'{-y,--yes}'[Do not prompt for emerge invocations (merges only)]' \
    '*--purgerepos=[Purge revisions for the specified repo (revisions only)]:repository:($repos)' \
    '--purgeallrepos[Purge revisions for all repos (revisions only)]' \
    '*'{-r,--repo=}'[Sync the specified repo (sync only)]:repository:($repos)' \
    '(-A --allrepos -a --auto)'{-A,--allrepos}'[Sync all repos that have a sync-url defined (sync only)]' \
    '(-A --allrepos -a --auto)'{-a,--auto}'[Sync auto-sync enabled repos only (sync only)]' \
    '*--sync-submodule=[Restrict sync to the specified submodule (sync only)]:submodule:(glsa news profiles)' \
    '--delete-individual-files[Also remove per-field files after writing the metadata file (vdb --fix only)]' \
    '(-R --remove)'{-R,--remove}'[Restore per-field files and remove the metadata files (vdb only)]' \
    '1:command: _describe -t commands "emaint command" commands'
}

