# vim: ft=yaml
# MAMBA_ROOT_PREFIX is set by the shell and direnv to the XDG data directory.
changeps1: false
show_channel_urls: true
# add_pip_as_python_dependency: true
channel_priority: strict
channels:
  - defaults
default_channels:
  - https://repo.anaconda.com/pkgs/main
  - https://repo.anaconda.com/pkgs/r
  - https://repo.anaconda.com/pkgs/msys2
custom_channels:
  conda-forge: https://conda.anaconda.org
  msys2: https://conda.anaconda.org
  bioconda: https://conda.anaconda.org
  menpo: https://conda.anaconda.org
  pytorch: https://conda.anaconda.org
  pytorch-lts: https://conda.anaconda.org
  simpleitk: https://conda.anaconda.org
  deepmodeling: https://conda.anaconda.org/
# when using "conda create" for envs these packages will always be installed
# adjust that list according your needs, the packages below are just a suggestion!
# create_default_packages:
#   - ipykernel
#   - jupyter
#   - pip
auto_activate_base: false
