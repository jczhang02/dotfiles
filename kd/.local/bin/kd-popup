#!/usr/bin/env bun
/**
 * kd-popup: fzf front end for the kd dictionary (tmux-palette `kd`, Alt+P).
 *
 *   kd-popup [TEXT...]   open the picker, looking TEXT up first and keeping
 *                        it in history when kd finds or translates it
 *
 * Typing looks up live, English or Chinese. A Chinese word lists its English
 * options with pronunciation and meaning; alt-1..9 looks one up and ctrl-o
 * comes back; Google Translate (translate-shell) adds more options. Four or
 * more words, a leading `-t`, or anything the dictionary lacks is translated
 * by Google and Youdao (`kd -t`) side by side. A leading `kd ` is ignored, so
 * `kd hello` works too. Enter keeps the entry in history with a short gloss;
 * up/down recall it; ctrl-s speaks the word (`kd -s`); ctrl-r looks it up
 * again bypassing kd's cache (`kd -n`).
 *
 * Internal, used by fzf bindings:
 *   kd-popup --render TEXT    print the colored entry for TEXT
 *   kd-popup --history        print saved entries, newest first
 *   kd-popup --remember TEXT  move TEXT to the top of history
 *   kd-popup --forget TEXT    drop TEXT from history
 *   kd-popup --pick N TEXT    print TEXT's Nth English option (or TEXT)
 *   kd-popup --back TEXT      print the entry before the last --pick (or TEXT)
 *   kd-popup --speak TEXT     pronounce TEXT in the background (English only)
 *   kd-popup --refresh TEXT   make the next --render of TEXT skip kd's cache
 *   kd-popup --copy TEXT      copy TEXT's answer to the clipboard
 */

import { mkdirSync, readFileSync, realpathSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const SELF = realpathSync(import.meta.path);
const STATE = join(process.env.XDG_STATE_HOME || join(homedir(), ".local/state"), "kd");
const HISTORY = join(STATE, "history"); // "text<TAB>gloss" per line, newest first
const LAST = join(STATE, "last"); // gloss of the latest render, reused by --remember
const TRAIL = join(STATE, "trail"); // "query<TAB>target" per --pick, for --back
const FRESH = join(STATE, "fresh"); // query whose next render skips kd's cache
const ANSWER = join(STATE, "answer"); // what ctrl-y copies for the last render
const MORE = join(STATE, "more"); // Google options of the last Chinese render, for --pick
const NET_TIMEOUT = 8_000; // Google / Youdao round trips
const HISTORY_MAX = 200;
const MAX_WIDTH = 96; // readable measure on wide terminals
const MAX_PICKS = 9; // alt-1..9

// 16-color ANSI so entries follow the terminal palette (Latte or Mocha).
const R = "\x1b[0m", B = "\x1b[1m", DIM = "\x1b[90m";
const HEAD = "\x1b[1;34m", TAG = "\x1b[35m", POS = "\x1b[32m", BADGE = "\x1b[33m";
const HL = "\x1b[1;34m"; // the looked-up word inside examples

type Entry = {
  k: string;
  pron?: Record<string, string> | null;
  para?: string[] | null;
  eg?: { bi?: string[][] | null; or?: string[][] | null } | null;
  co?: {
    star?: number;
    rank?: string;
    pat?: string; // word forms: "abandoning,abandoned,abandons"
    li?: { a?: string; maj?: string; eg?: string[][] | null }[] | null;
  } | null;
};

// --- text layout ------------------------------------------------------------

const width = (s: string) => Bun.stringWidth(s);

const CJK = "\\u2e80-\\u9fff\\uf900-\\ufaff\\uff00-\\uffef\\u3000-\\u303f";
const CLOSING = "，。；：、！？）」』”’》〉…";
const TOKEN = new RegExp(`[${CJK}][${CLOSING}]*|[^\\s${CJK}]+|\\s+`, "gu");
const BILINGUAL = new RegExp(`^(.*?)\\s*([(（]?\\s*[${CJK}].*)$`, "u");
const HAS_CJK = new RegExp(`[${CJK}]`, "u");
const POS_PREFIX = /^((?:[a-z]+\.\s*)*)(.*)$/;

/** Greedy wrap by display cells; CJK may break between characters. */
function wrap(text: string, measure: number): string[] {
  const lines: string[] = [];
  let line = "";
  let used = 0;
  for (let tok of text.trim().match(TOKEN) ?? []) {
    if (!tok.trim()) {
      if (line) {
        line += " ";
        used++;
      }
      continue;
    }
    let w = width(tok);
    if (used + w > measure && line.trim()) {
      lines.push(line.trimEnd());
      line = "";
      used = 0;
    }
    while (w > measure) {
      // a single token wider than the measure
      lines.push(tok.slice(0, measure));
      tok = tok.slice(measure);
      w = width(tok);
    }
    line += tok;
    used += w;
  }
  if (line.trim()) lines.push(line.trimEnd());
  return lines.length ? lines : [""];
}

/** Wrap `text` with a hanging indent; `first` replaces the first line's
 * indent (e.g. a styled label of the same cell width). */
function block(text: string, indent: number, measure: number, style = "", first?: string): string[] {
  const pad = " ".repeat(indent);
  return wrap(text, Math.max(10, measure - indent)).map(
    (row, i) => `${i === 0 && first !== undefined ? first : pad}${style}${row}${style ? R : ""}`,
  );
}

function truncate(s: string, cells: number): string {
  if (width(s) <= cells) return s;
  let out = "";
  for (const ch of s) {
    if (width(out + ch) > cells - 1) break;
    out += ch;
  }
  return `${out}…`;
}

const padTo = (s: string, cells: number) => s + " ".repeat(Math.max(0, cells - width(s)));

/** Collins glosses run "English sentence. 中文释义". */
function splitBilingual(s: string): [string, string] {
  const m = BILINGUAL.exec(s);
  return m?.[1] ? [m[1], m[2] ?? ""] : [s, ""];
}

/** Mark `terms` in `text`, returning to `style` afterwards. English terms
 * also match simple inflections (gives up, abandoned). */
function highlight(text: string, terms: string[], style = ""): string {
  const escape = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const alts = [...new Set(terms.filter(Boolean))]
    .sort((a, b) => b.length - a.length)
    .map((t) => {
      if (HAS_CJK.test(t)) return escape(t);
      const [first = "", ...rest] = t.split(" ").map(escape);
      return `\\b${first}(?:s|es|ed|d|ing)?${rest.map((w) => `\\s+${w}`).join("")}\\b`;
    });
  if (!alts.length) return text;
  return text.replace(new RegExp(alts.join("|"), "giu"), (m) => `${HL}${m}${R}${style}`);
}

function rule(title: string, measure: number, extra = ""): string {
  const label = title.toUpperCase() + (extra ? `  ${extra}` : "");
  return `  ${DIM}${label} ${"─".repeat(Math.max(4, measure - 3 - width(label)))}${R}`;
}

/** "  word ............ badge" across the measure. */
function headline(word: string, badge: string, measure: number): string {
  const head = `${HEAD}${word}${R}`;
  if (!badge) return `  ${head}`;
  const gap = Math.max(3, measure - 2 - width(word) - width(badge));
  return `  ${head}${" ".repeat(gap)}${badge}`;
}

function previewWidth(): number {
  const cols = Number(process.env.FZF_PREVIEW_COLUMNS) || process.stdout.columns || 80;
  return Math.min(cols - 2, MAX_WIDTH + 2);
}

// --- lookups ----------------------------------------------------------------

function classify(query: string): ["w" | "t", string] {
  let text = query.split(/\s+/).filter(Boolean).join(" ");
  if (text.startsWith("kd ")) text = text.slice(3);
  if (/^(-t|--text) /.test(text)) return ["t", text.slice(text.indexOf(" ") + 1)];
  return [(text.match(/ /g)?.length ?? 0) >= 3 ? "t" : "w", text];
}

function parseEntry(raw: string): Entry | null {
  try {
    const data = JSON.parse(raw) as Entry;
    if (!data.k) return null;
    // For Chinese input kd sometimes returns an example phrase instead of a
    // translation ("他放弃了出国的念头 he gives up..."); treat that as no entry.
    if (HAS_CJK.test(data.k) && !options(data).length) return null;
    return data;
  } catch {
    return null;
  }
}

/** stdout of `cmd`, or "" when it is missing, fails or times out. */
async function run(cmd: string[], timeout = NET_TIMEOUT): Promise<string> {
  try {
    const p = Bun.spawn(cmd, { stdout: "pipe", stderr: "ignore", timeout });
    return await new Response(p.stdout).text();
  } catch {
    return "";
  }
}

const cacheFlag = (fresh: boolean) => (fresh ? ["-n"] : []);

function lookupWord(word: string): Entry | null {
  const p = Bun.spawnSync(["kd", "--json", word], { stdout: "pipe", stderr: "ignore", timeout: 20_000 });
  return parseEntry(p.stdout.toString());
}

async function lookupWordAsync(word: string, fresh = false): Promise<Entry | null> {
  return parseEntry(await run(["kd", ...cacheFlag(fresh), "--json", word], 20_000));
}

/** Youdao (kd -t) alternatives, minus its "在例句中比较" link text. */
async function youdaoTranslate(text: string, fresh: boolean): Promise<string[]> {
  const out = (await run(["kd", ...cacheFlag(fresh), "-t", text])).split("\n").slice(1).join(" "); // kd echoes the source first
  return out
    .replace(/\s*在例句中比较\s*$/, "")
    .split(/\s+;\s+/)
    .map((s) => s.trim())
    .filter(Boolean);
}

/** Google Translate via translate-shell, Chinese ↔ English. */
async function googleTranslate(text: string): Promise<string> {
  const target = HAS_CJK.test(text) ? ":en" : ":zh";
  return (await run(["trans", "-b", "-no-ansi", target, text])).trim();
}

const GOOGLE_POS: Record<string, string> = {
  verb: "v.", noun: "n.", adjective: "adj.", adverb: "adv.", preposition: "prep.",
  conjunction: "conj.", pronoun: "pron.", interjection: "int.", abbreviation: "abbr.",
  phrase: "phr.", prefix: "pref.", suffix: "suf.", article: "art.", numeral: "num.",
};

type GoogleOption = { pos: string; text: string; back: string[] };

/** Google's dictionary block for a Chinese word: English options, each with
 * its Chinese back-translations ("abandon: 放弃, 抛弃, 弃, ..."). */
async function googleOptions(word: string): Promise<GoogleOption[]> {
  const lines = (await run(["trans", "-no-ansi", "zh:en", word])).split("\n");
  const start = lines.findIndex((l) => l.startsWith("Definitions of"));
  if (start < 0) return [];
  const out: GoogleOption[] = [];
  let pos = "";
  for (const line of lines.slice(start + 1)) {
    if (!line.trim() || line.startsWith("[")) continue;
    if (/^\S/.test(line)) {
      if (/^[A-Z]/.test(line)) break; // next section ("Translations of ...")
      pos = GOOGLE_POS[line.trim()] ?? line.trim();
    } else if (/^ {4}\S/.test(line)) {
      out.push({ pos, text: line.trim(), back: [] });
    } else if (/^ {8}\S/.test(line) && out.length) {
      out[out.length - 1]!.back = line.trim().split(/,\s*/);
    }
  }
  return out;
}

function readMore(word: string): string[] {
  try {
    const data = JSON.parse(readFileSync(MORE, "utf8")) as { k: string; opts: string[] };
    return data.k === word ? data.opts : [];
  } catch {
    return [];
  }
}

type Option = { pos: string; text: string };

/** English options of a Chinese entry: "vt. abandon ; waive" → abandon, waive. */
function options(entry: Entry): Option[] {
  const seen = new Set<string>();
  const out: Option[] = [];
  for (const para of entry.para ?? []) {
    const [, pos = "", rest = ""] = POS_PREFIX.exec(para) ?? [];
    for (const part of rest.split(/\s*;\s*/)) {
      const text = part.trim();
      if (!text || HAS_CJK.test(text) || seen.has(text.toLowerCase())) continue;
      seen.add(text.toLowerCase());
      out.push({ pos: pos.trim() === "misc." ? "" : pos.trim(), text });
    }
  }
  return out;
}

/** Short options get their own entry; sentences are shown as they are. */
const isTerm = (s: string) => s.split(" ").length <= 3 && !/[.!?]$/.test(s);

/** Jump targets in display order: kd's options, then Google's extra ones. */
function pickable(entry: Entry, more: string[] = readMore(entry.k)): string[] {
  const kd = options(entry)
    .map((o) => o.text)
    .filter(isTerm);
  const seen = new Set(kd.map((t) => t.toLowerCase()));
  return [...kd, ...more.filter((t) => !seen.has(t.toLowerCase()))].slice(0, MAX_PICKS);
}

function firstGloss(entry: Entry): string {
  if (HAS_CJK.test(entry.k)) {
    return options(entry)
      .slice(0, 3)
      .map((o) => o.text)
      .join("; ");
  }
  for (const para of entry.para ?? []) {
    const gloss = para.replace(/^(?:[a-z]+\.\s*)+/, "").trim();
    if (gloss) return gloss;
  }
  return "";
}

function preferredPron(entry: Entry): string {
  const pron = entry.pron ?? {};
  const raw = pron["英"] ?? pron["美"] ?? Object.values(pron)[0] ?? "";
  const ipa = raw.replace(/^\[|\]$/g, "").trim();
  return ipa ? `/${ipa}/` : "";
}

function saveLast(text: string, gloss: string, answer = gloss): void {
  try {
    mkdirSync(STATE, { recursive: true });
    writeFileSync(LAST, `${text}\t${gloss}\n`);
    writeFileSync(ANSWER, JSON.stringify({ k: text, v: answer }));
  } catch {}
}

// --- rendering --------------------------------------------------------------

/** Bilingual dictionary examples, else kd's corpus sentences; some entries
 * carry empty placeholder rows. */
function examplesOf(entry: Entry): string[][] {
  const usable = (rows?: string[][] | null) => (rows ?? []).filter(([eng]) => eng?.trim());
  const bi = usable(entry.eg?.bi);
  return bi.length ? bi : usable(entry.eg?.or);
}

function renderExamples(rows: string[][], measure: number, enTerms: string[], zhTerms: string[]): string[] {
  if (!rows.length) return [];
  const out = ["", rule("examples", measure), ""];
  for (const [eng = "", chs] of rows.slice(0, 5)) {
    out.push(...block(highlight(eng, enTerms), 4, measure, "", `  ${DIM}›${R} `));
    if (chs) out.push(...block(highlight(chs, zhTerms, DIM), 4, measure, DIM));
    out.push("");
  }
  return out;
}

function renderEnglish(entry: Entry, measure: number): string[] {
  const co = entry.co ?? {};
  let badges = (co.rank ?? "").split(/\s+/).filter(Boolean).join(" · ");
  if (co.star) badges = "★".repeat(co.star) + (badges ? `  ${badges}` : "");
  const out = ["", headline(entry.k, badges ? `${BADGE}${badges}${R}` : "", measure)];

  const pron = entry.pron ?? {};
  const accents = Object.keys(pron).sort((a, b) => Number(a !== "英") - Number(b !== "英"));
  if (accents.length) {
    const parts = accents.map((k) => `${DIM}${k}${R} /${(pron[k] ?? "").replace(/^\[|\]$/g, "")}/`);
    out.push(`  ${parts.join("   ")}`);
  }
  const forms = (co.pat ?? "").split(",").map((f) => f.trim()).filter(Boolean);
  if (forms.length) out.push(`  ${DIM}forms${R}  ${forms.join(` ${DIM}·${R} `)}`);
  out.push("");

  const paras = (entry.para ?? []).map((p) => {
    const m = POS_PREFIX.exec(p);
    return [(m?.[1] ?? "").trim(), m?.[2] ?? p] as const;
  });
  let col = Math.max(0, ...paras.map(([pos]) => width(pos)));
  if (col) col += 2;
  for (const [pos, gloss] of paras) {
    const label = `  ${POS}${pos}${R}${" ".repeat(col - width(pos))}`;
    out.push(...block(gloss, 2 + col, measure, "", label));
  }

  const terms = [entry.k, ...forms];
  const items = co.li ?? [];
  if (items.length) {
    out.push("", rule("collins", measure, String(items.length)));
    const numW = String(items.length).length;
    const indent = 2 + numW + 2;
    items.forEach((item, i) => {
      const [en, zh] = splitBilingual(item.maj ?? "");
      const tag = (item.a ?? "").trim();
      let lead: string | undefined = `  ${B}${String(i + 1).padStart(numW)}${R}  `;
      out.push("");
      if (tag) {
        out.push(`${lead}${TAG}${tag}${R}`);
        lead = undefined;
      }
      out.push(...block(en, indent, measure, "", lead));
      if (zh) out.push(...block(zh, indent, measure, DIM));
      for (const [eng = "", chs] of item.eg ?? []) {
        out.push(...block(highlight(eng, terms), indent + 2, measure, "", `${" ".repeat(indent)}${DIM}›${R} `));
        if (chs) out.push(...block(chs, indent + 2, measure, DIM));
      }
    });
  }

  out.push(...renderExamples(examplesOf(entry), measure, terms, []));
  return out;
}

/** A Chinese entry: its English options, each with pronunciation and gloss
 * from its own entry, so near-synonyms (abandon / waive / give up) can be told
 * apart; alt-N jumps to option N. */
async function renderChinese(entry: Entry, measure: number, emit: (lines: string[]) => Promise<void>): Promise<string[]> {
  const google = googleOptions(entry.k); // in flight while kd's rows render
  const out = ["", headline(entry.k, `${DIM}中 → 英${R}`, measure), ""];
  const opts = options(entry);
  const terms = opts.filter((o) => isTerm(o.text));

  if (!terms.length) {
    // Sentence translations: nothing to look up, just list them.
    for (const o of opts) out.push(...block(o.text, 4, measure, B, `  ${DIM}›${R} `));
  } else {
    const details = await Promise.all(terms.map((o) => lookupWordAsync(o.text)));
    const posW = Math.max(0, ...terms.map((o) => width(o.pos)));
    const wordW = Math.min(24, Math.max(...terms.map((o) => width(o.text))));
    const prons = details.map((d) => (d ? preferredPron(d) : ""));
    const pronW = Math.min(18, Math.max(0, ...prons.map(width)));
    let lastPos: string | undefined;
    terms.forEach((o, i) => {
      const d = details[i];
      const pos = o.pos === lastPos ? "" : o.pos;
      lastPos = o.pos;
      const key = i < MAX_PICKS ? `${DIM}${i + 1}${R}` : " ";
      const lead = `  ${POS}${padTo(pos, posW)}${R}${posW ? "  " : ""}${key}  `;
      const word = `${B}${padTo(truncate(o.text, wordW), wordW)}${R}`;
      const pron = pronW ? `  ${DIM}${padTo(truncate(prons[i] ?? "", pronW), pronW)}${R}` : "";
      const used = 2 + (posW ? posW + 2 : 0) + 3 + wordW + (pronW ? pronW + 2 : 0) + 2;
      const gloss = d ? truncate(firstGloss(d).replace(/^(?:[a-z]+\.\s*)+/, ""), measure - used) : "";
      out.push(`${lead}${word}${pron}  ${gloss}`);
    });
    // Other options that are whole sentences.
    const sentences = opts.filter((o) => !isTerm(o.text));
    if (sentences.length) {
      out.push("");
      for (const o of sentences) out.push(...block(o.text, 4, measure, "", `  ${DIM}›${R} `));
    }
  }
  await emit(out.splice(0));

  // Google's extra options, numbered after kd's for alt-N.
  const seen = new Set(terms.map((o) => o.text.toLowerCase()));
  const extra = (await google).filter((o) => !seen.has(o.text.toLowerCase()) && isTerm(o.text)).slice(0, 10);
  writeMore(entry.k, extra.map((o) => o.text));
  if (extra.length) {
    out.push("", rule("more", measure, "google"));
    const posW = Math.max(0, ...extra.map((o) => width(o.pos)));
    const wordW = Math.min(24, Math.max(...extra.map((o) => width(o.text))));
    let lastPos: string | undefined;
    extra.forEach((o, i) => {
      const n = terms.length + i + 1;
      const pos = o.pos === lastPos ? "" : o.pos;
      lastPos = o.pos;
      const key = n <= MAX_PICKS ? `${DIM}${n}${R}` : " ";
      const lead = `  ${POS}${padTo(pos, posW)}${R}${posW ? "  " : ""}${key}  `;
      const used = 2 + (posW ? posW + 2 : 0) + 3 + wordW + 2;
      const back = truncate(o.back.join("，"), measure - used);
      out.push(`${lead}${B}${padTo(truncate(o.text, wordW), wordW)}${R}  ${DIM}${back}${R}`);
    });
  }
  const n = Math.min(terms.length + extra.length, MAX_PICKS);
  if (n) out.push("", `  ${DIM}alt-${n === 1 ? "1" : `1…${n}`} look up   ctrl-o back${R}`);

  const enTerms = [...opts.map((o) => o.text), ...extra.map((o) => o.text)];
  out.push(...renderExamples(examplesOf(entry), measure, enTerms, [entry.k]));
  return out;
}

function writeMore(word: string, opts: string[]): void {
  try {
    mkdirSync(STATE, { recursive: true });
    writeFileSync(MORE, JSON.stringify({ k: word, opts }));
  } catch {}
}

const emitLines = async (lines: string[]) => {
  if (lines.length) await Bun.write(Bun.stdout, `${lines.join("\n")}\n`);
};

/** Google and Youdao side by side; each shows as soon as it arrives. */
async function renderText(text: string, measure: number, fresh: boolean): Promise<void> {
  const direction = HAS_CJK.test(text) ? "中 → 英" : "英 → 中";
  const google = googleTranslate(text);
  const youdao = youdaoTranslate(text, fresh);
  await emitLines(["", rule("translate", measure, direction), "", ...block(text, 2, measure, DIM), ""]);
  const label = (name: string) => `  ${DIM}${name.padEnd(8)}${R}`;
  const g = await google;
  if (g) await emitLines(block(g, 10, measure, B, label("google")));
  const same = (t: string) => t.toLowerCase().replace(/[\s.。!！?？]+$/, "");
  const y = (await youdao).filter((r) => same(r) !== same(g));
  for (const [i, r] of y.entries()) await emitLines(block(r, 10, measure, B, label(i ? "" : "youdao")));
  const first = g || y[0];
  if (first) saveLast(text, first);
  else await emitLines([`  ${DIM}No dictionary entry or translation.${R}`]);
}

function renderHelp(measure: number): string[] {
  const keys = [
    ["⏎", "keep in history"],
    ["↑ ↓", "recall history"],
    ["alt-1…9", "look up an English option of a Chinese word"],
    ["ctrl-o", "back to the previous entry"],
    ["ctrl-s", "speak the word (English)"],
    ["ctrl-r", "look up again, bypassing kd's cache"],
    ["ctrl-y", "copy the answer (meaning, English option or translation)"],
    ["click", "recall a history entry"],
    ["ctrl-f", "full-width entry (toggle)"],
    ["⇧ drag", "select text with the mouse; ctrl-f first to leave out the history"],
    ["⇧↑ ⇧↓", "scroll this panel"],
    ["^x", "forget the highlighted entry"],
    ["esc", "close"],
  ];
  const intro =
    "Type a word or phrase, English or Chinese, to look it up as you type. " +
    "Sentences and anything the dictionary lacks are translated by Google and Youdao.";
  return [
    "",
    `  ${HEAD}kd${R}  ${DIM}dictionary${R}`,
    "",
    ...block(intro, 2, measure, DIM),
    "",
    ...keys.map(([k = "", v = ""]) => `  ${B}${k.padEnd(9)}${R}${DIM}${v}${R}`),
  ];
}

async function render(query: string): Promise<void> {
  const [kind, text] = classify(query);
  const measure = previewWidth();
  if (!text) {
    console.log(renderHelp(measure).join("\n"));
    return;
  }
  const fresh = takeFresh(text);
  if (kind === "w") {
    await Bun.sleep(120);
    const entry = await lookupWordAsync(text, fresh);
    if (entry) {
      const answer = HAS_CJK.test(entry.k)
        ? (options(entry)[0]?.text ?? "")
        : (entry.para?.[0] ?? "").replace(/^(?:[a-z]+\.\s*)+/, "").trim();
      saveLast(text, firstGloss(entry), answer);
      const lines = HAS_CJK.test(entry.k) ? await renderChinese(entry, measure, emitLines) : renderEnglish(entry, measure);
      await emitLines(lines);
      return;
    }
  }
  // Sentences hit the network; wait out fast typing (fzf kills stale previews).
  await Bun.sleep(kind === "t" ? 600 : 400);
  await renderText(text, measure, fresh);
}

/** True once after `--refresh TEXT`: this render bypasses kd's cache. */
function takeFresh(text: string): boolean {
  try {
    if (readFileSync(FRESH, "utf8") !== text) return false;
    rmSync(FRESH, { force: true });
    return true;
  } catch {
    return false;
  }
}

function markFresh(query: string): void {
  const [, text] = classify(query);
  if (!text) return;
  mkdirSync(STATE, { recursive: true });
  writeFileSync(FRESH, text);
}

/** Copy the answer in the other language: an English word's meaning, a Chinese
 * word's first option, a translation; after an alt-N jump from a Chinese
 * word, the English word itself. Through tmux (OSC 52) so it also works over
 * SSH; wl-copy outside tmux. */
function copy(query: string): void {
  const [, text] = classify(query);
  if (!text) return;
  let value = "";
  const jumped = readTrail().at(-1)?.[1] === text;
  if (jumped) value = text;
  else {
    try {
      const data = JSON.parse(readFileSync(ANSWER, "utf8")) as { k: string; v: string };
      value = data.k === text ? data.v : "";
    } catch {}
  }
  if (!value) return;
  const opts = { stdin: Buffer.from(value), stdout: "ignore", stderr: "ignore" } as const;
  const done = process.env.TMUX
    ? Bun.spawnSync(["tmux", "load-buffer", "-w", "-"], opts).exitCode === 0
    : Bun.spawnSync(["wl-copy"], opts).exitCode === 0;
  if (done && process.env.TMUX) {
    Bun.spawnSync(["tmux", "display-message", `kd: copied ${truncate(value, 60)}`], { stdout: "ignore", stderr: "ignore" });
  }
}

/** `kd -s` downloads Google TTS audio (English only) and plays it; run it
 * detached so fzf stays responsive. */
function speak(query: string): void {
  const [, text] = classify(query);
  if (!text || HAS_CJK.test(text)) return;
  Bun.spawnSync(["sh", "-c", 'kd -s "$1" >/dev/null 2>&1 &', "sh", text], { stdout: "ignore", stderr: "ignore" });
}

// --- history ----------------------------------------------------------------

function loadHistory(): [string, string][] {
  let raw: string;
  try {
    raw = readFileSync(HISTORY, "utf8");
  } catch {
    return [];
  }
  return raw
    .split("\n")
    .filter((r) => r.trim())
    .map((r) => {
      const tab = r.indexOf("\t");
      return tab < 0 ? [r, ""] : [r.slice(0, tab), r.slice(tab + 1)];
    });
}

function writeHistory(rows: [string, string][]): void {
  mkdirSync(STATE, { recursive: true });
  const body = rows.slice(0, HISTORY_MAX).map(([t, g]) => `${t}\t${g}\n`);
  writeFileSync(`${HISTORY}.tmp`, body.join(""));
  renameSync(`${HISTORY}.tmp`, HISTORY);
}

function printHistory(): void {
  const rows = loadHistory();
  const pad = Math.min(Math.max(0, ...rows.map(([t]) => width(t))), 14);
  for (const [text, gloss] of rows) {
    console.log(`${text}\t${padTo(truncate(text, pad), pad + 2)}${DIM}${gloss}${R}`);
  }
}

function lastGloss(text: string): string {
  try {
    const line = readFileSync(LAST, "utf8").replace(/\n$/, "");
    const tab = line.indexOf("\t");
    return tab >= 0 && line.slice(0, tab) === text ? line.slice(tab + 1) : "";
  } catch {
    return "";
  }
}

/** Move `query` to the top of history with its gloss. With `foundOnly`, skip
 * words kd has no entry for and sentences it could not translate. */
function remember(query: string, foundOnly = false): void {
  const [kind, text] = classify(query);
  if (!text) return;
  let gloss = lastGloss(text);
  if (!gloss && kind === "w") {
    const entry = lookupWord(text);
    if (entry) gloss = firstGloss(entry);
  }
  if (foundOnly && !gloss) return;
  writeHistory([[text, gloss], ...loadHistory().filter(([t]) => t !== text)]);
}

function forget(text: string): void {
  writeHistory(loadHistory().filter(([t]) => t !== text));
}

// --- option jumps -----------------------------------------------------------

/** [query, target] per alt-N jump, oldest first. */
function readTrail(): [string, string][] {
  try {
    return readFileSync(TRAIL, "utf8")
      .split("\n")
      .filter(Boolean)
      .map((l) => {
        const [q = "", t = ""] = l.split("\t");
        return [q, t];
      });
  } catch {
    return [];
  }
}

function writeTrail(trail: [string, string][]): void {
  mkdirSync(STATE, { recursive: true });
  writeFileSync(TRAIL, trail.map(([q, t]) => `${q}\t${t}\n`).join(""));
}

/** Print option `n` of `query` (a Chinese entry), remembering `query` for
 * --back; print `query` unchanged when there is no such option. */
function pickOption(n: number, query: string): void {
  const [, text] = classify(query);
  const entry = text && HAS_CJK.test(text) ? lookupWord(text) : null;
  const target = entry ? pickable(entry)[n - 1] : undefined;
  if (!target) return void process.stdout.write(query);
  writeTrail([...readTrail(), [query, target]]);
  process.stdout.write(target);
}

function back(query: string): void {
  const trail = readTrail();
  const prev = trail.pop();
  writeTrail(trail);
  process.stdout.write(prev?.[0] ?? query);
}

// --- picker -----------------------------------------------------------------

function pick(query: string): void {
  const cols = process.stdout.columns || 80;
  const listWidth = Math.max(28, Math.min(44, Math.floor((cols * 3) / 10)));
  const layout = cols >= 100 ? `right,${cols - listWidth},wrap` : "down,65%,wrap";
  // Full-width preview: room for long entries, and a Shift+drag selection
  // then takes only the entry, not the history column beside it.
  const full = "down,99%,wrap"; // below the input, which keeps its width; fzf caps at 99%
  // Catppuccin Latte, matching FZF_DEFAULT_OPTS from the zsh env; popups run
  // a non-interactive shell that never loads it.
  const latte = [
    "bg+:#e6e9ef", "bg:#eff1f5", "fg:#4c4f69", "fg+:#4c4f69:bold", "hl:#d20f39",
    "hl+:#d20f39", "prompt:#8839ef", "pointer:#8839ef", "info:#9ca0b0", "spinner:#dc8a78",
    "query:#4c4f69:bold", "border:#ccd0da", "label:#8839ef", "footer:#8c8fa1",
    "ghost:#9ca0b0", "preview-border:#ccd0da",
  ].join(",");
  const recall = "transform-query(printf %s {1})";
  const me = `'${SELF}'`;
  const jumps = Array.from(
    { length: MAX_PICKS },
    (_, i) => `alt-${i + 1}:transform-query(${me} --pick ${i + 1} {q})`,
  );
  const opts = [
    "--ansi", "--disabled", "--layout=reverse", "--style=full:rounded", "--no-scrollbar",
    `--color=${latte}`, "--highlight-line", "--gutter= ", "--pointer=▌", "--no-sort",
    "--delimiter=\t", "--with-nth=2", "--prompt=❯ ", "--ghost=English or 中文",
    "--info=hidden", "--input-label= 󰗊 kd ", "--list-label= history ",
    "--list-label-pos=-3:bottom", "--footer-border=none",
    "--footer=⏎ keep   ↑↓ recall   ^x forget\n^y copy   ^s speak   ^f full",
    `--query=${query}`,
    `--preview=${me} --render {q}`,
    `--preview-window=${layout}`, "--preview-wrap-sign=  ",
    `--bind=up:up+${recall},down:down+${recall},ctrl-p:up+${recall},ctrl-n:down+${recall}`,
    // A click moves fzf's cursor, but the preview follows the query; recall
    // the clicked entry. Double-click would otherwise accept and close.
    `--bind=left-click:${recall},double-click:${recall}`,
    `--bind=enter:execute-silent(${me} --remember {q})+reload(${me} --history)+first`,
    `--bind=ctrl-x:execute-silent(${me} --forget {1})+reload(${me} --history)`,
    `--bind=${jumps.join(",")}`,
    `--bind=ctrl-o:transform-query(${me} --back {q})`,
    `--bind=ctrl-s:execute-silent(${me} --speak {q})`,
    `--bind=ctrl-y:execute-silent(${me} --copy {q})`,
    `--bind=ctrl-f:change-preview-window(${full}|${layout})`,
    `--bind=ctrl-r:execute-silent(${me} --refresh {q})+refresh-preview`,
    "--bind=esc:abort,ctrl-c:abort",
  ];
  rmSync(TRAIL, { force: true });
  // `kd <word>` from the palette counts as a lookup: a dictionary word goes
  // into history up front (so it shows in the list); anything translated
  // instead once its translation has rendered, known only after fzf exits.
  const [kind, text] = classify(query);
  if (text && kind === "w") remember(query, true);
  const feed = Bun.spawnSync([SELF, "--history"], { stdout: "pipe" }).stdout;
  Bun.spawnSync(["fzf", ...opts], { stdin: feed, stdout: "ignore", stderr: "inherit" });
  if (text && !loadHistory().some(([t]) => t === text)) remember(query, true);
}

const [cmd = "", ...rest] = process.argv.slice(2);
switch (cmd) {
  case "--render":
    await render(rest.join(" "));
    break;
  case "--history":
    printHistory();
    break;
  case "--remember":
    remember(rest.join(" "));
    break;
  case "--forget":
    forget(rest.join(" "));
    break;
  case "--pick":
    pickOption(Number(rest[0]), rest.slice(1).join(" "));
    break;
  case "--back":
    back(rest.join(" "));
    break;
  case "--speak":
    speak(rest.join(" "));
    break;
  case "--copy":
    copy(rest.join(" "));
    break;
  case "--refresh":
    markFresh(rest.join(" "));
    break;
  default:
    pick(process.argv.slice(2).join(" "));
}
