# Generated runtime files
btop/.config/btop/btop.log
fcitx/.config/fcitx5/conf/cached_layouts
# fcitx5 rewrites its profile (enabled input methods) on its own; keep local
fcitx/.config/fcitx5/profile
fontconfig/.config/fontconfig/conf.d/*.bak.*

# GTK bookmarks are rewritten by file managers; keep local
gtk/.config/gtk-3.0/bookmarks

# Local review handoff (contains host-specific operational details)
/DOTFILES-REVIEW.md

# OMC session/state (per-session, never commit)
.omc/

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Secrets & credentials
.env
.env.*
*.secret
.netrc
.pgpass
.htpasswd
credentials.json
token.json
secrets.yml
secrets.yaml

# Cloud & infra
.boto
.s3cfg
kubeconfig

# Claude Code lays its API types and a tsconfig.json beside a mod at every load
claude-mods/*/.claude-plugin/types/
claude-mods/*/tsconfig.json
