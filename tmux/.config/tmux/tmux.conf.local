# : << 'EOF'
# Oh my tmux!
# 💛🩷💙🖤❤️🤍
# https://github.com/gpakosz/.tmux
# (‑●‑●)> dual licensed under the WTFPL v2 license and the MIT license,
#         without any warranty.
#         Copyright 2012— Gregory Pakosz (@gpakosz).


# -- bindings ------------------------------------------------------------------

# preserve tmux stock bindings,
# while adding bindings that don't conflict with these stock bindings
# /!\ this disables some of Oh my tmux! bindings described in README.md
#   - true
#   - false (default)
tmux_conf_preserve_stock_bindings=false


# -- session creation ----------------------------------------------------------

# prompt for session name when creating a new session, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-session bindings)
tmux_conf_new_session_prompt=false

# new session retains current path, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-session bindings)
tmux_conf_new_session_retain_current_path=false


# -- windows & pane creation ---------------------------------------------------

# new window retains current path, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-window bindings)
tmux_conf_new_window_retain_current_path=true

# new window tries to reconnect ssh sessions, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-window bindings)
tmux_conf_new_window_reconnect_ssh=false

# new pane retains current path, possible values are:
#   - true (default)
#   - false
#   - disabled (do not modify split-window bindings)
tmux_conf_new_pane_retain_current_path=true

# new pane tries to reconnect ssh sessions, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify split-window bindings)
tmux_conf_new_pane_reconnect_ssh=false


# -- display -------------------------------------------------------------------

# RGB 24-bit colour support, possible values are:
#   - true
#   - false
#   - auto (default)
#
# automatic detection relies on the COLORTERM environment variable being defined
# to 'truecolor' or '24bit' or '$ tput colors' answering '16777216'
# see https://github.com/termstandard/colors
tmux_conf_24b_colour=auto


# -- theming -------------------------------------------------------------------

# enable or disable theming:
#   - enabled (default)
#   - disabled
# when disabled, all tmux_conf_theme_xxx variables are ignored except:
#   - tmux_conf_theme_pairing
#   - tmux_conf_theme_prefix
#   - tmux_conf_theme_mouse
#   - tmux_conf_theme_root
#   - tmux_conf_theme_synchronized
tmux_conf_theme=enabled

# Oh my tmux!'s original colour roles, mapped to Catppuccin Latte.
# Text that sits directly on the bar uses "default", so it follows Ghostty's
# light/dark switch; coloured blocks keep explicit fg+bg pairs.
tmux_conf_theme_colour_1="default"    # terminal   — status bar bg
tmux_conf_theme_colour_2="#ccd0da"    # Surface0   — pane border
tmux_conf_theme_colour_3="default"    # terminal   — inactive window fg (dimmed)
tmux_conf_theme_colour_4="#dd4fa5"    # Pink       — accent: current window, active pane
                                      #   (readable on both Latte and Mocha backgrounds)
tmux_conf_theme_colour_5="#df8e1d"    # Yellow     — messages / copy mode
tmux_conf_theme_colour_6="#11111b"    # Ink        — text on yellow
tmux_conf_theme_colour_7="#ffffff"    # White      — text on red (bell, PREFIX)
tmux_conf_theme_colour_8="#11111b"    # Ink        — text on green
tmux_conf_theme_colour_9="#df8e1d"    # Yellow     — session section
tmux_conf_theme_colour_10="default"   # terminal   — uptime section
tmux_conf_theme_colour_11="#40a02b"   # Green      — path section
tmux_conf_theme_colour_12="default"   # terminal   — indicators fg
tmux_conf_theme_colour_13="default"   # terminal   — username section fg
tmux_conf_theme_colour_14="default"   # terminal   — hostname / last window fg
tmux_conf_theme_colour_15="default"   # terminal   — indicators bg
tmux_conf_theme_colour_16="#d20f39"   # Red        — alerts only (bell, prefix)
tmux_conf_theme_colour_17="default"   # terminal   — hostname section bg

# Status bar colours that differ between Ghostty's light and dark themes; text
# meets WCAG AA (4.5:1) on the Crust bar in both. A client that reports no theme
# gets the dark value.
tmux_conf_theme_text_accent="#{?#{==:#{client_theme},light},#b4237a,#dd4fa5}"     # Pink; #dd4fa5 is only 2.8:1 on Latte Crust
tmux_conf_theme_text_subtle="#{?#{==:#{client_theme},light},#5c5f77,#9399b2}"     # Subtext1 / Overlay2, in place of dim
tmux_conf_theme_text_on_accent="#{?#{==:#{client_theme},light},#ffffff,#11111b}"  # label text on an accent block
tmux_conf_theme_mark_wait="#{?#{==:#{client_theme},light},#a26715,#f9e2af}"       # Yellow (3:1 glyph on Latte)
tmux_conf_theme_page_bg="#{?#{==:#{client_theme},light},#eff1f5,#1e1e2e}"         # Ghostty's own background

# Window icon: tmux-autoname sets @tmux-autoname-icon on every window from
# the program it runs, also after a manual rename. Glyph table and
# overrides (@tmux-autoname-icons) are in the plugin's README.
tmux_conf_theme_window_icon="#{@tmux-autoname-icon}"

# default theme (ansi)
#tmux_conf_theme_colour_1="colour0"
#tmux_conf_theme_colour_2="colour8"
#tmux_conf_theme_colour_3="colour8"
#tmux_conf_theme_colour_4="colour14"
#tmux_conf_theme_colour_5="colour11"
#tmux_conf_theme_colour_6="colour0"
#tmux_conf_theme_colour_7="colour15"
#tmux_conf_theme_colour_8="colour0"
#tmux_conf_theme_colour_9="colour11"
#tmux_conf_theme_colour_10="colour13"
#tmux_conf_theme_colour_11="colour10"
#tmux_conf_theme_colour_12="colour8"
#tmux_conf_theme_colour_13="colour15"
#tmux_conf_theme_colour_14="colour0"
#tmux_conf_theme_colour_15="colour0"
#tmux_conf_theme_colour_16="colour1"
#tmux_conf_theme_colour_17="colour15"

# window style
tmux_conf_theme_window_fg="default"
tmux_conf_theme_window_bg="default"

# highlight focused pane, possible values are:
#   - true
#   - false (default)
tmux_conf_theme_highlight_focused_pane=false

# focused pane colours:
tmux_conf_theme_focused_pane_bg="$tmux_conf_theme_colour_2"

# pane border style, possible values are:
#   - thin (default)
#   - fat
tmux_conf_theme_pane_border_style=thin

# pane borders colours:
# follows Ghostty's light/dark switch: Latte Surface0 / Mocha Surface1; a client
# that reports no theme gets the dark colour
tmux_conf_theme_pane_border="#{?#{==:#{client_theme},light},$tmux_conf_theme_colour_2,#45475a}"
tmux_conf_theme_pane_active_border="$tmux_conf_theme_colour_4"
%if #{>=:#{version},3.2}
tmux_conf_theme_pane_active_border="#{?pane_in_mode,$tmux_conf_theme_colour_9,#{?synchronize-panes,$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_4}}"
%endif

# pane indicator colours (display-panes)
tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

# status line style
tmux_conf_theme_message_fg="$tmux_conf_theme_colour_6"
tmux_conf_theme_message_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_message_attr="bold"

# status line command style (<prefix> : Escape)
tmux_conf_theme_message_command_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_message_command_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_command_attr="bold"

# window modes style
tmux_conf_theme_mode_fg="$tmux_conf_theme_colour_6"
tmux_conf_theme_mode_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_mode_attr="bold"

# status line style
tmux_conf_theme_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_attr="none"

# terminal title
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{hostname_full}
#     - #{hostname_full_ssh}
#     - #{username}
#     - #{username_ssh}
tmux_conf_theme_terminal_title="#h ❐ #S ● #I #W"

# window status style
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{hostname_full}
#     - #{hostname_full_ssh}
#     - #{username}
#     - #{username_ssh}
tmux_conf_theme_window_status_fg="$tmux_conf_theme_text_subtle"
tmux_conf_theme_window_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_attr="none"
# Inactive tabs: subtle text, no dimming. Marks after the name (agent-done.sh):
# accent dot = an agent finished while you were away, yellow dot = an agent
# waits for your answer (Claude Code permission prompt).
tmux_conf_theme_window_status_format=" #I $tmux_conf_theme_window_icon #W#{?@tmux-autoname-manual, #{@tmux-autoname-manual},}#{?window_zoomed_flag, 󰊓,}#{?window_bell_flag, 󰂞,}#{?@agent-done, #{?#{==:#{@agent-done},wait},#[fg=$tmux_conf_theme_mark_wait],#[fg=$tmux_conf_theme_text_accent]}●,} "
#tmux_conf_theme_window_status_format="#{circled_window_index} #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"
#tmux_conf_theme_window_status_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}"

# window current status style
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{hostname_full}
#     - #{hostname_full_ssh}
#     - #{username}
#     - #{username_ssh}
# current window: a tab in the page colour, so it reads as joined to the pane
# below; accent bold text, no underline
tmux_conf_theme_window_status_current_fg="$tmux_conf_theme_text_accent"
tmux_conf_theme_window_status_current_bg="$tmux_conf_theme_page_bg"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format=" #I $tmux_conf_theme_window_icon #W#{?@tmux-autoname-manual, #{@tmux-autoname-manual},}#{?window_zoomed_flag, 󰊓,} "
#tmux_conf_theme_window_status_current_format="#{circled_window_index} #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"
#tmux_conf_theme_window_status_current_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}"

# window activity status style
tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="none"   # activity monitoring is off (see user customizations)

# window bell status style
tmux_conf_theme_window_status_bell_fg="$tmux_conf_theme_colour_7"
tmux_conf_theme_window_status_bell_bg="$tmux_conf_theme_colour_16"
tmux_conf_theme_window_status_bell_attr="blink,bold"

# window last status style
tmux_conf_theme_window_status_last_fg="$tmux_conf_theme_text_subtle"
tmux_conf_theme_window_status_last_bg="$tmux_conf_theme_colour_1"   # same as any other tab
tmux_conf_theme_window_status_last_attr="none"

# status left/right sections separators
tmux_conf_theme_left_separator_main=""
tmux_conf_theme_left_separator_sub="|"
tmux_conf_theme_right_separator_main=""
tmux_conf_theme_right_separator_sub="|"
#tmux_conf_theme_left_separator_main='\uE0B0'  # /!\ you don't need to install Powerline
#tmux_conf_theme_left_separator_sub='\uE0B1'   #   you only need fonts patched with
#tmux_conf_theme_right_separator_main='\uE0B2' #   Powerline symbols or the standalone
#tmux_conf_theme_right_separator_sub='\uE0B3'  #   PowerlineSymbols.otf font, see README.md

# status left/right content:
#   - separate main sections with "|"
#   - separate subsections with ","
#   - built-in variables are:
#     - #{battery_bar}
#     - #{battery_hbar}
#     - #{battery_percentage}
#     - #{battery_status}
#     - #{battery_vbar}
#     - #{circled_session_name}
#     - #{hostname_ssh}
#     - #{hostname}
#     - #{hostname_full}
#     - #{hostname_full_ssh}
#     - #{loadavg}
#     - #{mouse}
#     - #{pairing}
#     - #{prefix}
#     - #{root}
#     - #{synchronized}
#     - #{uptime_y}
#     - #{uptime_d} (modulo 365 when #{uptime_y} is used)
#     - #{uptime_h}
#     - #{uptime_m}
#     - #{uptime_s}
#     - #{username}
#     - #{username_ssh}
# Left side: set in the user section below (status-left #!important). oh-my-tmux
# pads every section with a trailing space in the bar colour, which would leave
# a strip between the prefix block and the current tab.
tmux_conf_theme_status_left=""
#tmux_conf_theme_status_left=" ❐ #S | ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} | #{pretty_pane_current_path} "
# Right side, all empty in the common case:
#   - pairing / synchronized-panes indicators
#   - other sessions with an agent mark, each followed by its dot (the current
#     session's marks are on its tabs); pure formats, no shell
#   - the ssh host of the current pane. Only this one stays of the ssh/user
#     variables: each runs a shell every status-interval.
#   - machine uptime after "↑" (as in oh-my-tmux), at the right edge so it
#     never moves
# Colours that switch with the theme contain commas, which the *_fg/_bg lists
# would split, so they are set inline.
tmux_conf_theme_status_right=" #{pairing}#{synchronized}#{S:#{?#{&&:#{!=:#{session_name},#{client_session}},#{W:#{?@agent-done,1,}}},#[fg=$tmux_conf_theme_text_subtle]❐ #{session_name} #{?#{W:#{?#{==:#{@agent-done},wait},1,}},#[fg=$tmux_conf_theme_mark_wait],#[fg=$tmux_conf_theme_text_accent]}●  ,}} | #{?#{==:#{pane_current_command},ssh},󰣀 ,}#{hostname_ssh} | #[fg=$tmux_conf_theme_text_subtle]↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} "

# status left style
tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_14,$tmux_conf_theme_colour_10,$tmux_conf_theme_colour_8"
tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_1,$tmux_conf_theme_colour_10,$tmux_conf_theme_colour_11"
tmux_conf_theme_status_left_attr="none,none,none"

# status right style
tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12,$tmux_conf_theme_colour_13,$tmux_conf_theme_colour_14"
tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_15,$tmux_conf_theme_colour_15,$tmux_conf_theme_colour_17"
tmux_conf_theme_status_right_attr="none,bold,none"

# pairing indicator
tmux_conf_theme_pairing="⚇"                 # U+2687
tmux_conf_theme_pairing_fg="none"
tmux_conf_theme_pairing_bg="none"
tmux_conf_theme_pairing_attr="none"

# prefix indicator
tmux_conf_theme_prefix="⌨"                  # U+2328
tmux_conf_theme_prefix_fg="none"
tmux_conf_theme_prefix_bg="none"
tmux_conf_theme_prefix_attr="none"

# mouse indicator
tmux_conf_theme_mouse="↗"                   # U+2197
tmux_conf_theme_mouse_fg="none"
tmux_conf_theme_mouse_bg="none"
tmux_conf_theme_mouse_attr="none"

# root indicator
tmux_conf_theme_root="!"
tmux_conf_theme_root_fg="none"
tmux_conf_theme_root_bg="none"
tmux_conf_theme_root_attr="bold,blink"

# synchronized indicator
tmux_conf_theme_synchronized="⚏"            # U+268F
tmux_conf_theme_synchronized_fg="none"
tmux_conf_theme_synchronized_bg="none"
tmux_conf_theme_synchronized_attr="none"

# battery bar symbols
tmux_conf_battery_bar_symbol_full="◼"
tmux_conf_battery_bar_symbol_empty="◻"
#tmux_conf_battery_bar_symbol_full="♥"
#tmux_conf_battery_bar_symbol_empty="·"

# battery bar length (in number of symbols), possible values are:
#   - auto
#   - a number, e.g. 5
tmux_conf_battery_bar_length="auto"

# battery bar palette, possible values are:
#   - gradient (default)
#   - heat
#   - "colour_full_fg,colour_empty_fg,colour_bg"
#   - gradient(colour_fg_1,colour_fg_2,...,colour_fg_n)
tmux_conf_battery_bar_palette="gradient"
#tmux_conf_battery_bar_palette="#d70000,#e4e4e4,#000000"   # red, white, black
#tmux_conf_battery_bar_palette="gradient(#00afff,#47a2ff,#7c91ff,#ac7afb,#d65be2,#e163df,#eb6cdd,#f475db,#ec9ff1,#eac3fe,#efe2ff,#ffffff)"

# battery hbar palette, possible values are:
#   - gradient (default)
#   - heat
#   - "colour_low,colour_half,colour_full"
#   - gradient(colour_fg_1,colour_fg_2,...,colour_fg_n)
tmux_conf_battery_hbar_palette="gradient"
#tmux_conf_battery_hbar_palette="#d70000,#ff5f00,#5fff00"  # red, orange, green
#tmux_conf_battery_hbar_palette="gradient(#00afff,#47a2ff,#7c91ff,#ac7afb,#d65be2,#e163df,#eb6cdd,#f475db,#ec9ff1,#eac3fe,#efe2ff,#ffffff)"

# battery vbar palette, possible values are:
#   - gradient (default)
#   - heat
#   - "colour_low,colour_half,colour_full"
#   - gradient(colour_fg_1,colour_fg_2,...,colour_fg_n)
tmux_conf_battery_vbar_palette="gradient"
#tmux_conf_battery_vbar_palette="#d70000,#ff5f00,#5fff00"  # red, orange, green
#tmux_conf_battery_vbar_palette="gradient(#00afff,#47a2ff,#7c91ff,#ac7afb,#d65be2,#e163df,#eb6cdd,#f475db,#ec9ff1,#eac3fe,#efe2ff,#ffffff)"

# symbols used to indicate whether battery is charging or discharging
tmux_conf_battery_status_charging="↑"       # U+2191
tmux_conf_battery_status_discharging="↓"    # U+2193
#tmux_conf_battery_status_charging="🔌"     # U+1F50C
#tmux_conf_battery_status_discharging="🔋"  # U+1F50B

# clock style (when you hit <prefix> + t)
# you may want to use %I:%M %p in place of %R in tmux_conf_theme_status_right
tmux_conf_theme_clock_colour="$tmux_conf_theme_colour_4"
tmux_conf_theme_clock_style="24"


# -- clipboard -----------------------------------------------------------------

# in copy mode, copying selection also copies to the OS clipboard
#   - true
#   - false (default)
#   - disabled
# on Linux, this requires xsel, xclip or wl-copy
tmux_conf_copy_to_os_clipboard=false


# -- urlscan -------------------------------------------------------------------

# options passed to urlscan
tmux_conf_urlscan_options="--compact --dedupe"


# -- user customizations -------------------------------------------------------

# status line on top
set -g status-position top

# tabs carry their own padding
setw -g window-status-separator "" #!important

# Session icon (accent) and name, ending flush against the current tab. While the
# prefix is pressed the label turns into an accent block (in place of oh-my-tmux's
# red PREFIX). Colours as tmux_conf_theme_text_accent / _text_on_accent: the
# re-applied #!important lines cannot read those variables.
set -g status-left "#{?client_prefix,#[fg=#{?#{==:#{client_theme},light},#ffffff,#11111b}]#[bg=#{?#{==:#{client_theme},light},#b4237a,#dd4fa5}]#[bold] ❐ #S #[default], #[fg=#{?#{==:#{client_theme},light},#b4237a,#dd4fa5}]❐#[default] #S }" #!important

# no activity marker on window tabs; bells still show
set -g monitor-activity off

# Tint the bar with Catppuccin Crust so it reads apart from the panes below; the
# colour follows Ghostty's light/dark switch via #{client_theme} (dark when the
# client reports no theme). Embedded
# bg=default in the oh-my-tmux formats inherits it. #!important re-applies this
# after oh-my-tmux's theme step, which would otherwise reset status-style.
set -g status-style "fg=default,bg=#{?#{==:#{client_theme},light},#dce0e8,#11111b}" #!important
set-hook -g client-light-theme[100] "refresh-client"   # full redraw: status bar and pane borders
set-hook -g client-dark-theme[100]  "refresh-client"

# @agent-done is set by agent-done.sh (Claude Code Stop hook, Codex notify) and
# cleared when the window is viewed; session-window-changed covers every way of
# moving between windows (select-, next-, previous-window, mouse).
set-hook -g session-window-changed[101] "set -wu @agent-done"
set-hook -g client-session-changed[101] "set -wu @agent-done"
set-hook -g client-attached[101]        "set -wu @agent-done"

# Desktop notifications from Claude Code's ghostty-notify.sh: withdraw a pane's notification
# once you look at it (pane-focus-in also fires when Ghostty itself regains focus).
# ghostty-notify-click.service selects the pane whose notification you clicked.
set-hook -g pane-focus-in[101]   { run-shell -b "~/.config/tmux/notify-focus.sh dismiss '#{pane_id}'" }

# Ghostty capabilities not advertised by terminfo; fixed index keeps reload idempotent.
set -g  default-terminal "tmux-256color"
set -s  terminal-features[100] "xterm-ghostty:RGB:clipboard:hyperlinks:extkeys:strikethrough:sync"
set -s  extended-keys always
set -s  extended-keys-format csi-u                                    # pi works best with csi-u

# Size each window to the smallest client that is actually showing it, not to
# every client attached to the session.
set -g aggressive-resize on

# Fcitx5 IME — fixed indices avoid duplicate entries after config reloads.
set -g update-environment[100] WAYLAND_DISPLAY
set -g update-environment[101] XMODIFIERS
set -g update-environment[102] GTK_IM_MODULE
set -g update-environment[103] QT_IM_MODULE
set -g update-environment[104] INPUT_METHOD

# Refresh SSH vars on attach, so a server started over SSH does not leave a
# stale SSH_CLIENT that makes p10k show user@host in local panes.
set -g update-environment[110] SSH_CLIENT
set -g update-environment[111] SSH_TTY

# Each pane keeps its own fcitx5 English/Chinese state; new panes and shells
# start in English (logic in ime.sh). fcitx5 keeps one state per Ghostty window
# and cannot see pane, window or session switches inside tmux. The hook runs
# synchronously, so saving the old pane and restoring the new one never overlap.
set -g @ime_english_commands 'zsh bash sh dash fish ssh'
set-hook -g pane-focus-in[100] { run-shell "~/.config/tmux/ime.sh focus '#{pane_id}' '#{pane_current_command}' '#{@ime}' '#{@ime_english_commands}'" }
# Prune @ime_last_<pid> of clients that left, or one stays per old client.
set-hook -g client-detached[100] { run-shell "~/.config/tmux/ime.sh prune" }

# history
set -g history-limit 100000

# mouse + Vi keys
set -g mouse on
set -g status-keys vi
set -g mode-keys  vi

# Wheel in a full-screen app that does not take the mouse (less without --mouse,
# as bat and delta run it): send 3 Up/Down keys. A drag there still starts tmux
# copy mode, so text stays selectable.
bind -n WheelUpPane   if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { if -F "#{alternate_on}" { send-keys -N 3 Up } { copy-mode -e } }
bind -n WheelDownPane if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { if -F "#{alternate_on}" { send-keys -N 3 Down } }

# DO NOT exit-unattached: A3 grouped sessions need server to outlive last client
set -g exit-unattached off
# Detach the client when its session is destroyed instead of switching sessions.
set -g detach-on-destroy on

# Prefix → Ctrl-Space (main) + Ctrl-a (fallback)
unbind C-b
set -g prefix  C-Space
set -g prefix2 C-a
bind C-Space send-prefix
bind C-a     send-prefix -2

# prefix s → sesh picker (shared with zsh startup; see ~/.local/bin/sesh-pick)
# (replaces the stock choose-tree).
# 3.8+: modal floating pane. -K sends every key to fzf as a popup did (C-a is a
# prefix key, C-j/C-k belong to smart-splits); -D/-C close it on Esc or an
# outside click.
unbind s
%if #{>=:#{version},3.8}
bind s new-pane -O -K -D -C -x70% -y70% -X15% -Y15% -T sesh "~/.local/bin/sesh-pick"
%else
bind s display-popup -E -w 70% -h 70% -B "~/.local/bin/sesh-pick"
%endif
# prefix S → switch back to the previous session
bind S run-shell -b "sesh last >/dev/null 2>&1 || tmux display-message 'sesh: no previous session'"

# vi-mode: y → tmux buffer + OSC52 to the outer terminal (Ghostty writes the system
# clipboard). No forked wl-copy daemon, so dash-to-dock no longer plays its
# "new app" animation on every copy.
set -g set-clipboard on
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode    MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel

# Remove oh-my-tmux's M-y "yank-and-paste-pop" (emacs + vi mode). With
# copy_to_os_clipboard=false its perl transform strips wl-copy from
# "wl-copy; tmux paste-buffer", and tmux parses the leftover "; tmux ..." as a
# new command → syntax error. Vi-mode use does not need paste-pop.
unbind -T copy-mode    M-y
unbind -T copy-mode-vi M-y
# Remove tmux-yank-only bindings left behind when reloading a live server.
unbind -T prefix       Y
unbind -T copy-mode    y
unbind -T copy-mode    Y
unbind -T copy-mode-vi Y

# Kill keys, one per target; Enter confirms (-y)
# prefix x   → kill pane
# prefix q   → kill window (replaces display-panes)
# prefix X   → kill session
# prefix C-x → fzf multi-select sessions to kill (Tab marks, Enter confirms)
bind x confirm-before -y -p "kill pane #P? (Y/n)" kill-pane
bind q confirm-before -y -p "kill window #W? (Y/n)" kill-window
bind X confirm-before -y -p "kill session #S? (Y/n)" kill-session
# Retired duplicates; unbinding also clears them from a live server on reload.
unbind W
unbind Q
unbind &
unbind Z

%if #{>=:#{version},3.8}
bind C-x new-pane -O -K -D -C -x60% -y50% -X20% -Y25% -T "kill sessions" \
    "sh -c 'tmux list-sessions -F \"#S\" | \
        fzf --multi --reverse --prompt \"kill> \" --header \"Tab marks, Enter kills\" | \
        xargs -r -I{} tmux kill-session -t {}'"
%else
bind C-x display-popup -E -w 60% -h 50% \
    "sh -c 'tmux list-sessions -F \"#S\" | \
        fzf --multi --reverse --prompt \"kill> \" --header \"Tab marks, Enter kills\" | \
        xargs -r -I{} tmux kill-session -t {}'"
%endif

# prefix w → 3.8 switch-mode: fuzzy window switcher in a floating pane, the
# upstream default for Tab (oh-my-tmux keeps Tab = last-window, BTab = last session)
%if #{>=:#{version},3.8}
bind w { new-pane -E -T windows -x75% -y30% -X0 -Y0; move-pane -P bottom-centre; switch-mode -wk }
%endif

# prefix a → windows of the current session, each with the task titles of the
# agents in any of its panes (shells only carry the host name, so they show
# none). Names are cut and padded so the titles line up. run-shell -C expands
# #{session_name} at key press; ## stays a format.
bind a run-shell -C "choose-tree -Zw -f '##{==:##{session_name},#{session_name}}' -F '##{?window_format,##{@tmux-autoname-icon} ##{p32:##{=/31/…:window_name}}##{P:##{?##{m/r:^(claude|codex|pi|opencode)$,##{pane_current_command}},##{pane_title}  ,}},}'"

# prefix f → new floating pane in the current directory (3.8 default * stays);
# replaces find-window, which prefix w and prefix s cover
%if #{>=:#{version},3.8}
bind f new-pane -c "#{pane_current_path}"
%endif


# display a message after toggling mouse support
bind m run "cut -c3- '#{TMUX_CONF}' | sh -s _toggle_mouse" \; display 'mouse #{?#{mouse},on,off}'


# -- vim-style bindings --------------------------------------------------------

# gt/gT/gg — window cycle + jump to first (key-table chord on g); G jumps to last
# The chord lives in tmux's own `move` table, so 3.8's floating-pane keys stay
# reachable too: g 1-4 corners, g arrows edges (M- also resizes), g 0 fill.
unbind g
bind g switch-client -T move
bind -T move t next-window
bind -T move T previous-window
bind -T move g select-window -t :^         # gg → first window
unbind -T move e                           # retired ge, same as G

# G → last window (vim G = bottom)
bind G select-window -t :$

# / → enter copy-mode + forward search (vim /)
# prefix ? keeps the stock list-keys; in copy mode ? searches backward
bind / copy-mode \; send-keys /

# = → equalize the current pane's row or column, keeping the arrangement (vim Ctrl-w =);
# tiled stays on M-5
bind '=' select-layout -E

# main-vertical (M-4) / main-horizontal (M-3): the default 80-column main pane
# is too narrow on a wide screen
set -g main-pane-width  60%
set -g main-pane-height 65%

# -- tpm -----------------------------------------------------------------------

# while I don't use tpm myself, many people requested official support so here
# is a seamless integration that automatically installs plugins in parallel

# whenever a plugin introduces a variable to be used in 'status-left' or
# 'status-right', you can use it in 'tmux_conf_theme_status_left' and
# 'tmux_conf_theme_status_right' variables.

# by default, launching tmux will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_launch=false

# by default, reloading the configuration will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_reload=false

# by default, reloading the configuration will uninstall tpm and plugins when no
# plugins are enabled
#   - true (default)
#   - false
tmux_conf_uninstall_plugins_on_reload=true

# /!\ the tpm bindings differ slightly from upstream:
#   - installing plugins: <prefix> + I
#   - uninstalling plugins: <prefix> + Alt + u
#   - updating plugins: <prefix> + u

# /!\ do not add set -g @plugin 'tmux-plugins/tpm'
# /!\ do not add run '~/.tmux/plugins/tpm/tpm'

# /!\ the 'set -g @tpm_plugins' syntax is not supported
# to enable a plugin, use the 'set -g @plugin' syntax:
# visit https://github.com/tmux-plugins for available plugins


set -g pane-border-lines heavy

%if #{>=:#{version},3.8}
# titles only on floating panes (sesh, switch-mode, prefix *); tiled panes keep bare borders
set -g pane-border-status top-floating
set -g pane-border-format ' #{pane_title} '
# scrollbar only in copy/view mode, overlaying the pane so TUIs never reflow.
# Transparent track and a Catppuccin overlay1 slider: the default theme greys
# clash with both themes. The style is expanded without a client, so
# #{client_theme} is always empty here; #8c8fa1 suits latte and mocha alike.
set -g pane-scrollbars modal
set -g pane-scrollbars-style "bg=default,fg=#8c8fa1,width=1,pad=0"
# copy mode: R follows new pane output (refresh-toggle); r refreshes once (3.8 default)
bind -T copy-mode-vi R send -X refresh-toggle

# 3.8 paints menus, popups, choose-tree, display-panes and copy-mode matches from
# a ten-colour theme palette that tmux switches with the client's light/dark
# report. Its stock greys put fzf-tab's popup in a grey frame, so map the slots
# to Catppuccin Latte/Mocha by role:
#   dark-grey   floating surface: Base, the bg fzf paints, so popups and menus
#               read as the page with a hairline edge
#   light-grey  hairline: Overlay0, fzf's own border colour
#   white       text on the surface
#   black       ink on coloured blocks (#11111b, as on the yellow message bar)
#   cyan        copy-mode search matches only: a Surface0/Surface1 tint, quiet
#               enough that the current match stands out
#   magenta     current search match: the pink accent, as on the current window
set -s light-theme-black      "#11111b"
set -s light-theme-white      "#4c4f69"
set -s light-theme-light-grey "#9ca0b0"
set -s light-theme-dark-grey  "#eff1f5"
set -s light-theme-green      "#40a02b"
set -s light-theme-yellow     "#df8e1d"
set -s light-theme-red        "#d20f39"
set -s light-theme-blue       "#1e66f5"
set -s light-theme-cyan       "#ccd0da"
set -s light-theme-magenta    "#dd4fa5"
set -s dark-theme-black       "#11111b"
set -s dark-theme-white       "#cdd6f4"
set -s dark-theme-light-grey  "#6c7086"
set -s dark-theme-dark-grey   "#1e1e2e"
set -s dark-theme-green       "#a6e3a1"
set -s dark-theme-yellow      "#f9e2af"
set -s dark-theme-red         "#f38ba8"
set -s dark-theme-blue        "#89b4fa"
set -s dark-theme-cyan        "#45475a"
set -s dark-theme-magenta     "#dd4fa5"
# Plain text on the match tint (ink fails on the Mocha tint); choose-tree marks
# the current window with the accent instead of red, the others in plain text.
set -g copy-mode-match-style "bg=themecyan,fg=themewhite"
set -g tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},thememagenta,themewhite}"
# Popups and menus take the heavy edge of the floating panes, in the hairline grey.
set -g popup-border-lines heavy
set -g menu-border-lines heavy
%endif


# window names as <project>/<task>; the icon shows the program
set -g @plugin 'jczhang02/tmux-autoname'

# Native tmux copy-mode + OSC52 handles keyboard and mouse copy without helper processes.

# Ctrl-h/j/k/l moves across nvim splits + tmux panes. tmux half of smart-splits.nvim v3:
# branches on the pane option @pane-is-vim (set by the nvim plugin) instead of
# running ps on every keypress. @smart-splits_at_edge must match nvim move.at_edge.
set -g @plugin 'smart-splits-nvim/backend-tmux'
set -g @smart-splits_at_edge 'wrap'

# prefix u → fuzzy pick URL from current pane, open in browser
set -g @plugin 'wfxr/tmux-fzf-url'

# M-p (no-prefix) → tmux-palette: Raycast-like command palette (Bun-based)
# the default @palette-key C-Space is the tmux prefix, so use M-p
# Fork of eduwass/tmux-palette: `kd <word>` keyword items + IME/CJK input fix;
# a daily GitHub Action merges upstream main into it.
set -g @plugin 'jczhang02/tmux-palette'
set -g @palette-key 'M-p'


set -g allow-passthrough on

